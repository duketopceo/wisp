{
  "description": "[cua] confirm = always: the click asks first; the scripted chooser answers yes and cua-driver is called once.",
  "audio": "act.wav",
  "name": "act_confirm_yes",
  "config": {
    "pointer": {
      "mode": "drive",
      "backend": "auto"
    },
    "cua": {
      "confirm": "always"
    }
  },
  "fakes": {
    "cua": {
      "tools": {
        "list_windows": {
          "stdout": {
            "windows": [{
              "pid": 4242, "window_id": 1, "focused": true,
              "title": "Save document", "frame": [0, 0, 200, 200]
            }]
          }
        },
        "get_window_state": {
          "stdout": {
            "elements": [{
              "name": "Save", "role": "button", "frame": [0, 0, 40, 40]
            }]
          }
        }
      }
    },
    "hypr": {},
    "notify": {}
  },
  "endpoints": {
    "whisper": {
      "transcript": "wisp agent click the save button"
    },
    "brain": {
      "responses": [
        {
          "tool_calls": [
            {
              "name": "click",
              "arg": "10,20@logical"
            }
          ]
        },
        {
          "content": "Clicked save."
        }
      ]
    }
  },
  "expect": {
    "statuses": [
      "listening",
      "transcribing",
      "deciding",
      "acting",
      "awaiting_choice",
      "acting",
      "speaking",
      "done"
    ],
    "cua_calls": [
      "start_session",
      "start_recording",
      "list_windows",
      "list_windows",
      "get_window_state",
      "click",
      "stop_recording"
    ],
    "steps_contain": [
      "CLICKED(10,20)"
    ]
  },
  "scenario": "choose/confirm",
  "chooser": {
    "pick": "run click: 10,20@logical? \u2014 yes",
    "delay_ms": 20
  }
}
