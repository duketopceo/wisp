{
  "description": "Act route: click through the fake cua-driver (daemon socket + CLI); notify and Hyprland fakes on PATH.",
  "audio": "act.wav",
  "name": "act_click_cua",
  "config": {
    "pointer": {
      "mode": "drive",
      "backend": "auto"
    }
  },
  "fakes": {
    "cua": {
      "tools": {
        "list_windows": {
          "stdout": {
            "windows": [{
              "pid": 4242, "window_id": 1, "focused": true,
              "title": "Save document", "frame": [0, 0, 200, 200]
            }]
          }
        },
        "get_window_state": {
          "stdout": {
            "elements": [{
              "name": "Save", "role": "button", "frame": [0, 0, 40, 40]
            }]
          }
        }
      }
    },
    "hypr": {},
    "notify": {}
  },
  "endpoints": {
    "whisper": {
      "transcript": "wisp agent click the save button"
    },
    "brain": {
      "responses": [
        {
          "tool_calls": [
            {
              "name": "click",
              "arg": "10,20@logical"
            }
          ]
        },
        {
          "content": "Clicked save."
        }
      ]
    }
  },
  "expect": {
    "tool_calls": [
      "click"
    ],
    "cua_calls": [
      "start_session",
      "start_recording",
      "list_windows",
      "list_windows",
      "get_window_state",
      "click",
      "stop_recording"
    ],
    "result_prefix": "ACTED"
  },
  "scenario": "act click via cua"
}
