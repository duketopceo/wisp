            "discord": 0.5,
            "browser": 0.3,
            "terminal": 0.2
          }
        },
        "action": {
          "choice": "launch",
          "probabilities": {
            "launch": 0.9,
            "answer": 0.1
          }
        },
        "risk": {
          "score": 0
        }
      }
    },
    "brain": {
      "responses": [
        {
          "content": ""
        }
      ]
    }
  },
  "chooser": {
    "pick": "app:discord",
    "delay_ms": 20
