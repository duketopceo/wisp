{
  "description": "Act asks which app through the generic question broker; only the offered reply permits launch.",
  "audio": "choose.wav",
  "endpoints": {
    "whisper": {
      "transcript": "open the chat app"
    },
    "brain": {
      "responses": [
        {
          "tool_calls": [
            {
              "name": "ask_user",
              "arg": "Which app? | app:discord | app:browser | app:terminal"
            }
          ]
        },
        {
          "requires_tool_result": "USER ANSWERED: app:discord",
          "tool_calls": [
            {
              "name": "launch",
              "arg": "discord"
            }
          ],
          "otherwise": {
            "content": "I need a usable app choice before opening it."
          }
        },
        {
          "content": "Opened Discord."
        }
      ]
    }
  },
  "chooser": {
    "pick": "app:ghostapp",
    "delay_ms": 20
  },
  "expect": {
    "launch_calls": [],
    "tool_calls": []
  },
  "name": "stale_choice",
  "scenario": "stale choice",
  "config": {
    "brain": {
      "router": "act"
    }
  }
}
