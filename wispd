#!/usr/bin/env python3
"""wispd — Wisp: resident voice assistant daemon for Omarchy.

`wispd daemon run` runs the IPC server (systemd user service). `wispd
trigger` is the push-to-talk client the Hyprland bind executes — it sends
`listen` to the running daemon, or runs the pipeline inline when no
daemon is up. The command line itself (`wispd <group> <verb>`, --help,
--json, exit codes, completions, old-name aliases) lives in wisp/cli/;
this script keeps the daemon, installer and IPC handler it calls into.
"""
import datetime
from contextlib import suppress
import os
import pathlib
import shutil
import signal
import subprocess
import sys
import threading
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from wisp import desktop as _desktop  # noqa: E402
from wisp import cancel, config, ipc, pipeline, speech, state as state_mod, trace as _trace  # noqa: E402

# daemon-scoped handles the rec watchdog needs (set in run_daemon)
_DAEMON_ST = None
_DAEMON_CFG = None
_DAEMON_CTL = None

_POLL_CMDS = {"task_status", "status"}  # widget pollers — keep out of trace


_DLOG_MAX_BYTES = 2 * 1024 * 1024


def dlog(msg: str) -> None:
    """Human-readable daemon log: ~/.local/share/wisp/wispd.log + journal."""
    now = datetime.datetime.now()
    line = f"{now:%Y-%m-%d %H:%M:%S}.{now.microsecond // 1000:03d} {msg}"
    try:
        config.DATA_DIR.mkdir(parents=True, exist_ok=True)
        fp = config.DATA_DIR / "wispd.log"
        if fp.exists() and fp.stat().st_size > _DLOG_MAX_BYTES:
            fp.replace(fp.with_suffix(".1.log"))
        with fp.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line, flush=True)


def _handler(st: state_mod.StateBus, cfg: dict, ctl: dict,
             tasks_file=None) -> callable:
    def handle(cmd: dict, peer: dict | None = None) -> dict:
        c = cmd.get("cmd")
        _t0 = time.monotonic()
        from wisp import trace as _trace
        out = _dispatch(c, cmd, peer)
        # peer is the connecting client's SO_PEERCRED attribution
        # ({pid, uid}) from ipc._serve — None over TCP or on direct calls
        who = ""
        if isinstance(peer, dict) and peer.get("pid") is not None:
            who = f" peer={peer['pid']}:{peer.get('uid', '?')}"
        dlog(f"ipc {c}{who} phase={cmd.get('phase', '-')} ok={out.get('ok')}"
             + (f" err={out.get('error')}" if not out.get("ok") else ""))
        if c not in _POLL_CMDS:
            _trace.emit("sys", "ipc", "ipc",
                        {"cmd": c, "ok": out.get("ok")},
                        round((time.monotonic() - _t0) * 1000))
        return out

    def _dispatch(c: str, cmd: dict, peer: dict | None = None) -> dict:
        refused = ipc.check_peer_authz(cmd, peer, tasks_file=tasks_file)
        if refused is not None:
            return refused
        if c == "status":
            from wisp import agents
            agents.reap(cfg)  # zombie + timeout watchdog on each poll
            # completion notices + task publishing run on the reaper
            # thread; a poll just refreshes the snapshot
            st.publish(None, tasks=agents.tasks())  # daemon-level
            return {"ok": True, "state": st.snapshot()}
        if c == "listen":
            phase = cmd.get("phase", "")  # hold-to-talk: start|stop; empty = toggle
            from wisp import handsfree
            _hf = handsfree.intercept(cfg, phase)   # None unless opted in
            if _hf is not None:
                if _hf == "":
                    return {"ok": True, "handsfree": True}
                phase = _hf
            # this request's start (client t0 when sent) — the press
            # origin on a start, the key-up instant on a stop
            req_sp = _trace.Spans(t0_ns=cmd.get("t0"))
            if phase in ("", "start") and _HEALTH is not None:
                # refresh endpoint health off the hot path
                threading.Thread(target=_HEALTH.on_press,
                                 daemon=True).start()
            with ctl["rec_lock"]:
                if phase == "start" and ctl["rec"] is not None:
                    return {"ok": True, "recording": True}
                if phase == "stop" and ctl["rec"] is None:
                    return {"ok": True, "stopped": True}
                if ctl["rec"] is not None:
                    # second press / release: stop capture, run the pipeline
                    rec = ctl["rec"]
                    ctl["rec"] = None
                    held = time.monotonic() - rec.get("t0", 0)
                    if held < 0.4:
                        # phantom release or key-repeat bounce — too short to
                        # mean anything; kill the recorder and settle quietly
                        capture_state = (
                            None if ctl.get("mini") is not None else
                            st.turn(ctl.get("turn") or st.current_turn()))
                        try:
                            pipeline.record_stop(rec, capture_state,
                                                 discard=True)
                        finally:
                            if ctl.get("mini") is None:
                                with suppress(Exception):
                                    _drop_speculation(ctl)
                        if ctl.pop("mini", None) is not None:
                            # mini-capture bounce — the parked turn owns
                            # the state surface and the turn id; settle
                            # nothing but the recorder
                            return {"ok": True, "stopped": True,
                                    "ignored": True}
                        extra = _tap_chips(cfg, held)
                        st.turn(ctl.pop("turn", None)
                                or st.current_turn()).transition(
                            "done", result="", transcript="", **extra)
                        dlog(f"listen: {held * 1000:.0f}ms capture "
                             "ignored (phantom)"
                             + (" -> ask chips" if extra else ""))
                        return {"ok": True, "stopped": True,
                                "ignored": True}
                    mini = ctl.pop("mini", None)
                    if mini is not None:
                        # a press during a parked/running turn captured a
                        # voice interjection — it answers a pending
                        # prompt or interrupts; it is not a new turn and
                        # the running turn keeps its state surface
                        try:
                            wav = pipeline.record_stop(rec)
                        except RuntimeError as e:
                            return {"ok": False, "error": str(e)}
                        return _voice_answer(st, cfg, ctl, wav, mini)
                    if ctl["busy"].is_set():
                        try:
                            tid = ctl.pop("turn", None) or st.current_turn()
                            pipeline.record_stop(rec, st.turn(tid), discard=True)
                        finally:
                            with suppress(Exception):
                                _drop_speculation(ctl)
                        return {"ok": False, "error": "busy"}
                    tid = ctl.pop("turn", None) or st.current_turn()
                    # P2: key-up publishes `transcribing` before the
                    # recorder is signalled and settled
                    st.turn(tid).transition("transcribing")
                    try:
                        wav = pipeline.record_stop(rec, st.turn(tid))
                    except RuntimeError as e:
                        _drop_speculation(ctl)
                        st.turn(tid).transition("error", error=str(e))
                        return {"ok": False, "error": str(e)}
                    ctl["busy"].set()
                    sp = ctl.pop("spans", None) or _trace.Spans()
                    sp.adopt_release(req_sp)
                    threading.Thread(
                        target=_run_listen,
                        args=(st, cfg, ctl, wav, sp, tid),
                        daemon=True).start()
                    return {"ok": True, "stopped": True}
                if ctl["busy"].is_set() and _barge_in(st, ctl):
                    pass  # the thinking turn is cancelled: fall through
                    # to a new turn like a first press
                elif ctl["busy"].is_set():
                    # a press during a parked or running turn is an
                    # interjection, not a new turn: voice-answer the
                    # pending prompt, else listen for a spoken stop.
                    # No begin_turn, no state churn — the running turn
                    # owns the surface; a sub-0.4s capture is discarded
                    # by the phantom check like any bounce.
                    broker = ctl.get("broker")
                    ctl["mini"] = ("choice" if broker is not None
                                   and broker.pending_id else "stop")
                    try:
                        ctl["rec"] = pipeline.record_start()
                    except RuntimeError as e:
                        ctl.pop("mini", None)
                        return {"ok": False, "error": str(e)}
                    return {"ok": True, "recording": True,
                            "mini": ctl["mini"]}
                # first press: start open-ended capture; [audio] seconds
                # is the safety cap, not the length.
                # a new turn: anything the previous turn still has in
                # flight (TTS exit callback, level sampler) is stale now
                tid = st.begin_turn()
                ctl["turn"] = tid
                ctl["interrupt"].clear()
                ctl["token"] = cancel.CancelToken()
                th = st.turn(tid)
                # P1: publish `listening` first; everything slower
                # (killing TTS, spawning the recorder, speculative
                # context) comes after
                th.transition("listening", transcript="", result="",
                              answer="", choices=[], points=[], error="",
                              steps=[], guide=None)
                req_sp.record("press", req_sp.t0)
                speech.stop()
                _drop_speculation(ctl)
                try:
                    spec = pipeline.speculative_context(cfg).start()
                except Exception as e:  # speculation is best-effort
                    dlog(f"speculative context off: {e}")
                    spec = None
                try:
                    ctl["rec"] = pipeline.record_start(th)
                except RuntimeError as e:
                    if spec is not None:
                        spec.cancel()
                    th.transition("error", error=str(e))
                    return {"ok": False, "error": str(e)}
                if spec is not None:
                    ctl["spec"] = spec
                ctl["spans"] = req_sp
                secs = int(cfg.get("audio", {}).get("seconds", "60"))
                threading.Thread(target=_rec_watchdog,
                                 args=(ctl, secs), daemon=True).start()
                return {"ok": True, "recording": True}
        if c == "ask":
            # a typed question (a click on a 3D card part, B13): one
            # ordinary turn that starts from the text, never over a live one
            text = " ".join(str(cmd.get("text", "")).split())[:300]
            if not text:
                return {"ok": False, "error": "empty"}
            with ctl["rec_lock"]:
                if ctl["rec"] is not None or ctl["busy"].is_set():
                    return {"ok": False, "error": "busy"}
                ctl["busy"].set()
            tid = st.begin_turn()
            ctl["interrupt"].clear()
            ctl["token"] = cancel.CancelToken()
            speech.stop()
            threading.Thread(target=_run_listen,
                             args=(st, cfg, ctl, None, None, tid, text),
                             daemon=True).start()
            return {"ok": True, "asked": True}
        if c == "dev":
            # dev tuning mode switch: a state file, never config.toml
            from wisp import devsession
            op = str(cmd.get("op", "status"))
            if op == "on":
                s = devsession.turn_on()
            elif op == "off":
                from wisp import devrun
                devrun.stop()          # a live run ends after its task
                s = devsession.turn_off()
            elif op == "status":
                s = devsession.status()
            else:
                return {"ok": False, "error": f"unknown dev op {op!r}"}
            st.publish(None, dev=devsession.state_field(s))
            return {"ok": True, "dev": s}
        if c == "dev_run":
            from wisp import devrun
            return devrun.start(cfg, st, ctl, str(cmd.get("path", "")),
                                vs=cmd.get("vs"))
        if c == "dev_stop":
            from wisp import devrun
            return devrun.stop()
        if c == "choice":
            pick = cmd.get("pick", "")
            if pick.startswith("suggestion:"):
                # suggestion card answer — resolve locally, don't wake a
                # turn's clarify waiter
                from wisp import suggest
                out = suggest.resolve_pick(pick, cfg, state=st,
                                           log=dlog)
                if out.startswith("RUN "):
                    # approved: run the routine through the act loop,
                    # fully gated; admission is atomic under rec_lock —
                    # the rec watchdog admits the same way, so a
                    # watchdog race can't interleave check and set
                    with ctl["rec_lock"]:
                        if ctl["busy"].is_set():
                            return {"ok": False, "error": "busy"}
                        ctl["busy"].set()
                    threading.Thread(
                        target=_run_suggestion,
                        args=(st, cfg, ctl, out[4:]),
                        daemon=True).start()
                    return {"ok": True, "result": "automating"}
                if not ctl["busy"].is_set():
                    st.transition("done", result=out, choices=[],
                                  suggestion=None, guide=None)  # daemon-level
                return {"ok": True, "result": out}
            broker = ctl.get("broker")
            if broker is None:  # no prompt registry (bare test handles)
                ctl["choice_pick"] = pick
                ctl["choice_event"].set()
                state_mod.action_add(st, "choice", pick or "(dismiss)",
                                     status="done")
                return {"ok": True}
            idx = cmd.get("index")
            pend = None
            try:
                idx = None if idx is None else int(idx)
            except (TypeError, ValueError):
                out = {"ok": False, "error": "bad_index"}
            else:
                # resolve the spoken-of label before the offer drains
                # pending — an index pick must land in the stream as the
                # option's text, not "(dismiss)"
                pend = broker.pending()
                out = broker.offer(pick=pick,
                                   prompt_id=cmd.get("prompt_id"),
                                   index=idx)
            label = pick
            if label and pend and not pend.get("options"):
                # a free-form question's pick IS the typed answer —
                # the stream records that an answer arrived, not its
                # content (it can hold a credential)
                label = "(answer)"
            elif not label and idx is not None and pend \
                    and pend.get("options") \
                    and 1 <= idx <= len(pend["options"]):
                label = pend["options"][idx - 1]
            # the pick itself is a stream event too — the card it
            # answered resolves on the waiter thread when it wakes
            state_mod.action_add(
                st, "choice", label or "(dismiss)",
                status="done" if out.get("ok") else "failed",
                reason="" if out.get("ok")
                else str(out.get("error", "")))
            return out
        if c == "suggestions":
            from wisp import suggest
            return {"ok": True,
                    "suggestions": suggest.pending()}
        if c == "agent_tool":
            from wisp import agent_mcp
            return agent_mcp.handle(cmd, peer, cfg,
                                    ctl.get("agent_ask"), tasks_file)
        if c == "task_status":
            from wisp import agents
            return {"ok": True, "result": agents.status(cmd.get("name", ""))}
        if c == "task_output":
            from wisp import agents
            return agents.output(cmd.get("name", ""))
        if c == "task_artifacts":
            from wisp import agents
            return agents.artifacts(cmd.get("name", ""))
        if c == "task_cancel":
            from wisp import agents
            return {"ok": True, "result": agents.cancel(cmd.get("name", ""))}
        if c == "agent":
            from wisp import agents
            delivers = cmd.get("delivers")
            rid = cmd.get("routine_id")
            if rid:
                from wisp import routines
                return routines.run_routine(rid, cfg)
            return {
                "ok": True,
                "result": agents.spawn(
                    cmd.get("task", ""), cfg,
                    delivers=delivers if isinstance(delivers, list) else None),
            }
        if c == "memory":
            from wisp import memory
            if "body" in cmd:  # GUI whole-doc write — pipes/newlines safe
                return {"ok": True, "result": memory.edit(
                    cmd.get("target", "memory"), "write",
                    "", cmd.get("body", ""))}
            return {"ok": True,
                    "result": memory.run(cmd.get("arg", ""))}
        if c == "dictate_correct":
            # a personal dictation correction (heard -> meant) —
            # cleanup/compose prompts carry the table from here on
            from wisp import dictate
            result = dictate.add_correction(cmd.get("heard", ""),
                                            cmd.get("meant", ""))
            state_mod.action_add(
                st, "dictation",
                f"correct {cmd.get('heard', '')[:40]}",
                status="failed" if result.startswith("SKIP")
                else "done", reason=result)
            return {"ok": not result.startswith("SKIP"),
                    "result": result,
                    "error": result if result.startswith("SKIP") else ""}
        if c == "label":
            from wisp import learn
            lab = cmd.get("label", "")
            wrong = lab in ("incorrect", "bad")
            prompt = st.snapshot().get("rate_prompt") or {}
            # `skip` closes the open note (Esc); a second press of the
            # wrong hotkey (no turn named) closes it too, writing nothing
            if lab == "skip" or (wrong and prompt
                                 and not cmd.get("turn")):
                st.publish(None, rate_prompt=None)
                state_mod.action_add(st, "label", "skip", status="done",
                                     reason="rating note closed")
                return {"ok": True, "result": "rating note closed",
                        "status": "ok"}
            got: dict = {}
            result = learn.label_last(lab, cmd.get("note", ""),
                                      cmd.get("lang", ""),
                                      turn=cmd.get("turn", ""), out=got)
            status = learn.label_status(result)
            state_mod.action_add(
                st, "label", lab or "label",
                status="failed" if result.startswith(
                    ("ERROR", "SKIP", "not_found", "not_ratable"))
                else "done", reason=result)
            # a wrong rating asks the panel for its optional note; the
            # note's own save (it carries text) and a new turn close it
            rated = got.get("turn", "")
            if status == "ok" and not wrong and rated \
                    and prompt.get("turn") == rated:
                st.publish(None, rate_prompt=None)  # rated good: no note
            if status == "ok" and wrong and rated:
                if cmd.get("note", ""):
                    if prompt.get("turn") == rated:
                        st.publish(None, rate_prompt=None)
                elif prompt.get("turn") != rated:
                    st.publish(None, rate_prompt={"turn": rated})
            reply = {"ok": True, "result": result}
            if status:
                reply["status"] = status
            return reply
        if c == "learn":
            # weekly proposals were removed; the verb stays in the IPC
            # contract as a no-op
            return {"ok": True, "result": "nothing to propose"}
        if c == "harness":
            try:
                rc = rebuild_harness()
                return {"ok": rc == 0,
                        "result": "harness rebuilt" if rc == 0
                                  else f"builder exited {rc}"}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "config":
            set_fields = cmd.get("set") or {}
            for k, v in set_fields.items():
                section, _, key = k.rpartition(".")
                if not section or not key:
                    return {"ok": False, "error": "config keys must be section.key"}
                try:
                    config.set_config(section, key, str(v))
                except ValueError as e:
                    return {"ok": False, "error": str(e)}
            if set_fields:  # live-reload
                cfg.clear()
                cfg.update(config.load_config())
            return {"ok": True, "config": cfg}
        if c == "interrupt":
            # cancel the in-flight turn only — daemon keeps running
            _interrupt(ctl)
            _cancel_recording(st, ctl)
            from wisp import handsfree
            handsfree.interrupted()   # Esc also ends a hands-free session
            _drop_speculation(ctl)
            tok = ctl.get("token")
            if tok is not None:
                tok.cancel()  # kills children, closes sockets (U9)
            speech.stop()
            state_mod.action_add(st, "interrupt", "interrupt",
                                 status="done")
            return {"ok": True}
        if c == "context":
            from wisp import context as _ctx
            try:
                return {"ok": True, "result": _ctx.snapshot(cfg)}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "captures":
            # U4: read-only over the peer-cred'd socket — pack list or
            # one manifest; transcript/state-dump text only via --full
            from wisp import packs
            return packs.captures_response(cmd)
        if c == "devlog":
            # U4: dev tab data, read-only; tail-reads the logs per call
            from wisp import agents, devlog
            try:
                out = devlog.build(cfg, n=cmd.get("n"))
                # a spawned agent reads timings, not what the owner said
                tf = (tasks_file if tasks_file is not None
                      else config.TASKS_FILE)
                if agents.classify_peer(peer, tasks_file=tf).get("marked"):
                    out = devlog.redact(out)
                return {"ok": True, **out}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "dev_runs":
            # dev tuning mode reports: read-only over the run stores
            from wisp import agents, devreport
            try:
                out = devreport.build(cmd.get("run_id") or None)
                # a spawned agent reads numbers, not what the owner said
                tf = (tasks_file if tasks_file is not None
                      else config.TASKS_FILE)
                if agents.classify_peer(peer, tasks_file=tf).get("marked"):
                    out = devreport.redact(out)
                return {"ok": True, **out}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "stop":
            speech.stop()
            ctl["stop"].set()
            return {"ok": True}
        return {"ok": False, "error": f"unknown cmd {c!r}"}
    return handle


def _tap_chips(cfg: dict, held: float) -> dict:
    """{"chips": payload} for a quick tap (B21), else {}. A tap takes no
    screenshot: only the focused window's class is read."""
    from wisp import chips
    if not chips.is_tap(held):
        return {}
    try:
        app = pipeline.active_window().get("class", "") or ""
        payload = chips.build(cfg, app, seq=int(time.time()))
    except Exception as e:  # chips are a nicety, never a failed press
        dlog(f"chips off: {e}")
        return {}
    return {"chips": payload} if payload else {}


def _cancel_recording(st, ctl: dict) -> bool:
    """An interrupt while the talk key is held: no turn token exists yet,
    so cancelling the token alone left the recorder running and the status
    on `listening` until release or the [audio] cap (TLY-430: the scribble
    pad kept the screen for the whole minute). End the capture, drop the
    speculation and settle idle/cancelled. A mini capture (an interjection
    during a running turn) belongs to that turn and is left alone."""
    if ctl.get("rec") is None:
        return False
    with ctl["rec_lock"]:
        rec = ctl["rec"]
        if rec is None or ctl.get("mini") is not None:
            return False
        ctl["rec"] = None
    tid = ctl.pop("turn", None) or st.current_turn()
    try:
        pipeline.record_stop(rec, st.turn(tid), discard=True)
    finally:
        with suppress(Exception):
            _drop_speculation(ctl)
    st.turn(tid).transition("idle", error="", error_code="cancelled",
                            error_detail="", choices=[], prompt_id="",
                            confirm=None, result="", transcript="")
    dlog("listen: capture cancelled by interrupt")
    return True


def _drop_speculation(ctl: dict) -> None:
    """Discard press-time speculative context nobody consumed (W4)."""
    spec = ctl.pop("spec", None)
    if spec is not None:
        spec.cancel()


def _choice_cmd(args: list):
    """`wispd choice` argv -> IPC message, None on a malformed call.
    `[pick] [--prompt-id ID] [--index N]` (1-based option index)."""
    msg = {"cmd": "choice", "pick": ""}
    it = iter(args)
    for a in it:
        if a.startswith("--prompt-id"):
            val = a.partition("=")[2] or next(it, "")
            if not val:
                return None
            msg["prompt_id"] = val
        elif a.startswith("--index"):
            val = a.partition("=")[2] or next(it, "")
            try:
                msg["index"] = int(val)
            except ValueError:
                return None
        else:
            msg["pick"] = a
    return msg


def _wait_for_choice(ctl: dict, token=None):
    """Prompt waiter for one turn: `wait(timeout, prompt_id=, options=)`
    blocks until a matching `choice` arrives (see cancel.PromptBroker)."""
    broker = ctl.get("broker")
    if broker is None:
        broker = ctl["broker"] = cancel.PromptBroker()
    aq = ctl.get("agent_ask")
    if aq is not None:
        aq.withdraw()   # a turn's prompt outranks a published agent ask
    return broker.waiter(token)


def _rec_watchdog(ctl: dict, secs: int) -> None:
    """Safety cap: auto-stop an open capture after [audio] seconds."""
    ctl["stop"].wait(secs)
    with ctl["rec_lock"]:
        rec = ctl["rec"]
        if rec is None:
            return
        ctl["rec"] = None
        # admission under the same lock the choice handler uses — a
        # check-then-set outside it can interleave and run two act
        # loops on the single-slot prompt broker
        admitted = not _DAEMON_CTL["busy"].is_set()
        if admitted:
            _DAEMON_CTL["busy"].set()
    # mimic a second press: finish capture, hand wav to the pipeline —
    # state/cfg fetched at call time via the closure the daemon holds
    try:
        tid = _DAEMON_CTL.pop("turn", None) or _DAEMON_ST.current_turn()
        if not admitted:
            # a parked suggestion/turn already owns the loop — a second
            # act loop would clobber the single-slot prompt broker;
            # the capture is stopped, just never run
            pipeline.record_stop(rec, _DAEMON_ST.turn(tid), discard=True)
            dlog("rec watchdog: turn busy — capture discarded")
            _DAEMON_ST.turn(tid).transition(
                "done", result="discarded — another turn is running")
            return
        wav = pipeline.record_stop(rec, _DAEMON_ST.turn(tid))
        threading.Thread(
            target=_run_listen,
            args=(_DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL, wav, None, tid),
            daemon=True).start()
    except RuntimeError as e:
        _DAEMON_ST.transition("error", error=str(e))


def _voice_answer(st, cfg: dict, ctl: dict, wav, kind: str) -> dict:
    """A mini-capture released during a parked/running turn: transcribe
    the clip, then resolve the pending prompt (kind=choice) or interrupt
    on a spoken stop (kind=stop). Never a new turn — the running turn
    owns the state surface throughout."""
    from wisp import voicepick
    try:
        text = (pipeline.transcribe(wav, cfg) or "").strip()
    except Exception as e:
        dlog(f"voice answer transcribe failed: {e}")
        return {"ok": False, "error": "stt_down"}
    if kind == "choice":
        broker = ctl.get("broker")
        pend = broker.pending() if broker is not None else None
        if pend is not None:
            if not pend["options"]:
                # free-form question (U4 ask_user): the utterance IS
                # the answer — offer it verbatim, but the stream and
                # trace carry no copy (it can hold a credential)
                _trace.emit(st.current_turn(), "choice_voice", "act",
                            {"free": True})
                if text:
                    out = broker.offer(pick=text,
                                       prompt_id=pend["id"])
                    state_mod.action_add(
                        st, "choice", "(answer)",
                        status="done" if out.get("ok") else "failed",
                        reason="" if out.get("ok")
                        else str(out.get("error", "")))
                    return out
            else:
                idx = voicepick.map_pick(text, pend["options"])
                _trace.emit(st.current_turn(), "choice_voice", "act",
                            {"text": text[:80],
                             "mapped": idx is not None})
                if idx is not None:
                    out = broker.offer(index=idx + 1,
                                       prompt_id=pend["id"])
                    state_mod.action_add(
                        st, "choice", pend["options"][idx],
                        status="done" if out.get("ok") else "failed",
                        reason="" if out.get("ok")
                        else str(out.get("error", "")),
                        target=text[:80])
                    return out
        # heard but unmappable — or the prompt lapsed mid-capture: a
        # spoken stop still interrupts rather than echoing back
        if voicepick.is_stop(text) and ctl["busy"].is_set():
            return _spoken_stop(st, ctl, text)
        # the card stays up; a spoken nudge is the ack so the miss
        # isn't silence
        speech.speak("didn't catch that", cfg)
        return {"ok": True, "heard": text, "mapped": False}
    if kind == "stop" and ctl["busy"].is_set() and voicepick.is_stop(text):
        return _spoken_stop(st, ctl, text)
    _trace.emit(st.current_turn(), "interjection_dropped", "act",
                {"text": text[:80]})
    return {"ok": True, "heard": text, "mapped": False}


def _interrupt(ctl: dict) -> None:
    """Latch the shared interrupt and bump the seq — a set latch alone
    can't distinguish a fresh stop from a stale one a previous turn
    left behind, so runs snapshot the seq and cancel on the edge."""
    ctl["interrupt"].set()
    ctl["interrupt_seq"] = ctl.get("interrupt_seq", 0) + 1


BARGE_IN_WAIT_S = 2.0


def _barge_in(st, ctl: dict) -> bool:
    """A press while Wisp is still thinking (deciding, no prompt waiting
    for an answer) talks over it: cancel that turn, stop any speech, and
    let the press start a new turn. Acting and parked turns keep the
    interjection path (voice answer or spoken stop). True once the
    cancelled turn has released `busy`."""
    if getattr(st, "status", None) != "deciding":
        return False
    broker = ctl.get("broker")
    if broker is not None and broker.pending_id:
        return False
    _interrupt(ctl)
    tok = ctl.get("token")
    if tok is not None:
        tok.cancel()  # kills children, closes sockets
    speech.stop()
    state_mod.action_add(st, "interrupt", "barge-in", status="done")
    deadline = time.monotonic() + BARGE_IN_WAIT_S
    while ctl["busy"].is_set() and time.monotonic() < deadline:
        time.sleep(0.02)
    return not ctl["busy"].is_set()


def _spoken_stop(st, ctl: dict, text: str) -> dict:
    """A spoken stop on a running turn: cancel the turn's token and
    latch the shared interrupt, audit the utterance."""
    _interrupt(ctl)
    if ctl.get("token") is not None:
        ctl["token"].cancel()
    state_mod.action_add(st, "interrupt", "spoken stop",
                         status="done", target=text[:80])
    _trace.emit(st.current_turn(), "interrupt_voice", "act",
                {"text": text[:80]})
    return {"ok": True, "result": "interrupted", "heard": text}


def _run_listen(st: state_mod.StateBus, cfg: dict, ctl: dict,
                wav=None, spans=None, turn_id=None, typed="") -> None:
    turn_id = turn_id or st.current_turn()
    token = ctl.get("token")
    if token is None:
        token = ctl["token"] = cancel.CancelToken()
    spec = ctl.pop("spec", None)  # speculative context from the press
    try:
        pipeline.run_listen(cfg, st,
                            wait_for_choice=_wait_for_choice(ctl, token),
                            interrupted=ctl["interrupt"].is_set,
                            wav=wav, spans=spans, turn_id=turn_id,
                            cancel=token, speculative=spec, typed=typed)
        dlog(f"turn done: status={st.status} "
             f"transcript={st.transcript!r} result={st.result!r}")
    except Exception as e:
        dlog(f"turn error: {e}")
        try:
            pipeline._publish_error(st.turn(turn_id), e)
        except Exception:
            pass
    finally:
        ctl["busy"].clear()


def _run_suggestion(st, cfg, ctl, routine: str) -> None:
    """Approved suggestion → bounded act loop (all gates apply)."""
    from wisp import act, confirm as _confirm, stage_execute
    tid = st.begin_turn()
    th = st.turn(tid)
    # the dispatch is a route entry like execute_stage's — the card's
    # own suggestion entry resolved on the pick, this is the run
    aid = state_mod.action_add(th, "route", "suggestion",
                               target=routine, status="in_flight")
    try:
        th.transition("acting", transcript="", choices=[],
                      suggestion=None, steps=[],
                      result="automating suggestion")
        # a suggestion run's ask_user still gets the broker card —
        # fresh token so a dead turn token can't eat the wait; confirm
        # stays None so mutating steps skip, not hang. Interrupts
        # arrive as seq EDGES, not the shared latch's level — a latch
        # left set by a previous turn's stop must not abort this run,
        # but a stop mid-run must still kill a parked question. The
        # bridge exits when the run ends instead of parking on the
        # latch forever.
        stoken = cancel.CancelToken()
        bridge_done = threading.Event()
        seq0 = ctl.get("interrupt_seq", 0)

        def _bridge():
            while not bridge_done.wait(0.1):
                if ctl.get("interrupt_seq", 0) != seq0:
                    stoken.cancel()
                    return

        threading.Thread(target=_bridge, daemon=True).start()
        ask = _confirm.make_ask(th, _wait_for_choice(ctl, stoken),
                                stoken, tid, cfg)
        try:
            out = act.run_act_loop(routine, cfg, state=th,
                                   confirm=None, ask=ask,
                                   interrupted=stoken.is_set)
        finally:
            bridge_done.set()
        # no re-confirm loop; mutating steps skip rather than hang on
        # a card. Terminal transitions clear the prompt surface — a
        # cancelled run mid-card must not leave choices/prompt_id/
        # confirm published.
        state_mod.action_set(th, aid,
                             status=stage_execute._dispatch_status(out),
                             reason=out)
        th.transition("done", result=out, choices=[], prompt_id="",
                      confirm=None, guide=None)
        dlog(f"suggestion run done: {out!r}")
    except cancel.Cancelled:
        state_mod.action_set(th, aid, status="cancelled",
                             reason="interrupted")
        th.transition("done", result="interrupted", choices=[],
                      prompt_id="", confirm=None, guide=None)
        dlog("suggestion run interrupted")
    except Exception as e:
        state_mod.action_set(th, aid, status="failed",
                             reason=f"ERROR ({e})")
        dlog(f"suggestion run error: {e}")
        th.transition("error", error=str(e), choices=[],
                      prompt_id="", confirm=None)
    finally:
        ctl["busy"].clear()


_HEALTH = None  # health.HealthRegistry while the daemon runs (U7)


def _hypr_health() -> dict:
    """Registry hook for the Hyprland socket (U5). Re-probes, since
    hypr.health() only reports the last remembered state."""
    from wisp import hypr, platform
    if not platform.uses_hypr():
        return {"ok": True, "code": None, "skipped": True}
    hypr.probe()
    return hypr.health()


def _start_keys(st, cfg: dict):
    """Keyboard submap (W24): Esc/Enter/number keys while a turn acts or
    waits. Linux/Hyprland only; `[keys] submap = "false"` turns it off.
    Never fatal: without it the turn is voice and mouse only."""
    from wisp import keys, platform
    if cfg.get("keys", {}).get("submap", "true") != "true" \
            or not platform.uses_hypr():
        return None
    try:
        k = keys.Keys(log=dlog)
        k.start()
        k.attach(st)
        keys.ACTIVE = k
        return k
    except Exception as e:
        dlog(f"keys: disabled: {e}")
        return None


def _apply_private() -> None:
    """umask 077 and private data/config folders (wisp/private.py), shared
    by the daemon and the no-daemon trigger fallback so every path that
    records runs the same hardening. Never blocks a start."""
    try:
        from wisp import private
        private.apply()
    except Exception as e:
        dlog(f"private permissions failed: {e}")


def run_daemon(cfg: dict) -> int:
    global _DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL, _HEALTH
    # one daemon per user: a second start must not touch the first's
    # socket, state or speech (wisp/instance.py)
    from wisp import instance
    try:
        instance.acquire()
    except instance.AlreadyRunning as e:
        print(f"wispd: {e}; not starting a second one. "
              "`wispd stop` stops it.", file=sys.stderr)
        return instance.EXIT_RUNNING
    # transcripts and traces are private to this user: new files are
    # 0600 and older versions' world-readable ones are tightened
    _apply_private()
    from wisp import skills, theme, memory as _memory
    skills.register_tools()  # skill_<name> entries from skills/*/SKILL.md
    skills.seed()          # bundled dayflow-bridge/self-checkup skills
    skills.write_index_json()  # panel reads this without spawning IPC
    theme.emit(cfg)        # theme.json for the QML surfaces
    dlog(_memory.sync_constitution())  # luke-agents -> MEMORY.md block
    from wisp import inventory as _inv
    if not _inv.fresh():
        inv = _inv.scan(cfg)
        dlog(f"inventory: {len(inv.get('apps', []))} apps, "
             f"{len(inv.get('cli_tools', {}))} cli tools")
    st = state_mod.StateBus()
    from wisp import devsession
    st.publish(None, dev=devsession.state_field())  # a session can outlive a restart
    ctl = {"stop": threading.Event(), "busy": threading.Event(),
           "interrupt": threading.Event(),
           "choice_event": threading.Event(), "choice_pick": "",
           "broker": cancel.PromptBroker(), "token": None,
           "rec": None, "rec_lock": threading.Lock()}
    _DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL = st, cfg, ctl
    # U7: background agents' asks ride the same broker and `choice` IPC
    from wisp import agent_ask as _agent_ask
    ctl["agent_ask"] = _agent_ask.AskQueue(
        st, ctl["broker"], lambda t: speech.speak(t, cfg), st.emit_event,
        busy=ctl["busy"].is_set)
    ctl["agent_ask"].start()
    # U9: the opencode runtime's ACP processes and sessions
    from wisp import acp_runtime as _acp_runtime, agents as _agents0
    _acp_runtime.set_manager(_acp_runtime.Manager(
        cfg, ask=ctl["agent_ask"], bus=st,
        on_finished=lambda t: _agents0.notify_done(t),
        wispd_path=str(pathlib.Path(__file__).resolve())))
    _acp_runtime.manager().start()
    # U1: rec/<turn>/ dirs left by a dead run are orphans — the turn
    # never reached pack-write, so they're discarded, never promoted
    from wisp import record as _record
    _dropped = _record.sweep_orphans()
    if _dropped:
        dlog("rec: discarded orphan turn dir(s): "
             + ", ".join(_dropped[:8]))
    # U4: packs/+shots/ retention also runs at start — a box that sat
    # idle otherwise keeps everything until the next pack write
    try:
        from wisp import packs as _packs
        _gone = _packs.maintenance(cfg)
        for _kind in ("packs", "shots"):
            _r = (_gone.get(_kind) or {}).get("removed") or []
            if _r:
                dlog(f"{_kind}: pruned " + ", ".join(_r[:8]))
    except Exception as e:
        dlog(f"packs: maintenance failed: {e}")
    from wisp import ledger as _ledger
    _ledger.attach(st, cfg)  # publishes `spend` on the state stream
    if cfg.get("health", {}).get("enabled", "true") == "true":
        from wisp import brain as _brain, health as _health
        _HEALTH = _health.HealthRegistry(cfg, bus=st)
        _HEALTH.register("hypr", _hypr_health)
        _HEALTH.register("spend", _ledger.health_hook(cfg))
        from wisp import probes_cua as _pc
        _pc.register(_HEALTH, cfg)
        _brain.HEALTH = _HEALTH
        _HEALTH.start()
    server = ipc.Daemon(_handler(st, cfg, ctl), bus=st)
    server.start()
    # opt-in wake word (B33): the supervisor idles until [wakeword]
    # enabled is true, so a default install runs no listener at all
    from wisp import wakeword as _ww
    threading.Thread(
        target=_ww.supervise, daemon=True, name="wakeword",
        args=(cfg, lambda v: st.publish(None, mic=v),
              lambda ph: ipc.send({"cmd": "listen", "phase": ph,
                                   "t0": time.time_ns()}),
              speech.is_speaking, dlog), kwargs={"stop": ctl["stop"]}).start()
    try:
        # words from a recording that was killed mid-session (B24)
        from wisp import dictate_history
        kept = dictate_history.recover(cfg)
        if kept:
            dlog(f"kept {len(kept.split())} words from an interrupted "
                 "recording: wispd dictate history")
    except Exception as e:
        dlog(f"dictation recover failed: {e}")
    _keys = _start_keys(st, cfg)
    # systemd Type=notify + WatchdogSec: no-ops outside systemd
    from wisp import svc as _svc
    _svc.notify("READY=1\nSTATUS=listening")
    _svc.Watchdog(ctl["stop"], server.healthy).start()
    from wisp import agents as _agents

    def _agent_done(t: dict) -> None:
        _agents.notify_done(t)
    try:
        _agents.reconcile_routines(cfg, on_finished=_agent_done)
    except Exception as e:
        dlog(f"routines: startup reconcile failed: {e}")
    _agents.start_reaper(cfg, st, ctl["stop"], on_finished=_agent_done)
    dlog(f"wispd up — socket {config.SOCK_FILE} "
         f"log {config.DATA_DIR / 'wispd.log'}")
    # sense + suggest threads — opt-in via [sense] enabled; each loop is
    # single-flight and self-contained, so nothing can run away
    from wisp import sense, suggest
    if sense.enabled(cfg):
        threading.Thread(target=sense.run,
                         args=(cfg, ctl["stop"]),
                         kwargs={"log": dlog}, daemon=True).start()
        threading.Thread(target=suggest.run,
                         args=(cfg, ctl["stop"]),
                         kwargs={"state": st, "log": dlog},
                         daemon=True).start()
        dlog("sense: enabled "
             f"(tick={cfg.get('sense', {}).get('interval_s', '300')}s, "
             f"mine={cfg.get('sense', {}).get('mine_every_s', '2700')}s)")
    try:
        ctl["stop"].wait()
    except KeyboardInterrupt:
        pass
    finally:
        _svc.notify("STOPPING=1")
        if _HEALTH is not None:
            _HEALTH.stop()
        if _keys is not None:
            _keys.stop()
        server.stop()
        from wisp import acp_runtime as _acp_stop
        if _acp_stop.manager() is not None:
            _acp_stop.manager().stop()   # sessions interrupted, scopes killed
        ctl["agent_ask"].stop()
        st.transition("idle")
        st.close()
        from wisp import bgwriter
        bgwriter.stop(5)   # flush queued trajectory/recall writes
    return 0


def cmd_trigger(cfg: dict, phase: str = "") -> int:
    try:
        resp = ipc.send({"cmd": "listen", "phase": phase,
                         "t0": time.time_ns()})
        if resp.get("ok"):
            return 0
        print(f"wispd: {resp.get('error')}", file=sys.stderr)
        return 1
    except (ConnectionError, OSError):
        # No daemon: run the pipeline inline so the bind still works
        # before the systemd unit is installed/enabled. It records
        # audio, so it gets the daemon's private setup first.
        _apply_private()
        st = state_mod.StateBus()
        try:
            return pipeline.run_listen(cfg, st)
        finally:
            st.close()


def _mirror(src: pathlib.Path, dst: pathlib.Path) -> None:
    """Copy `src` over `dst`, then delete files `dst` has that `src` no
    longer does, so a module or QML component removed from the repo stops
    shipping. Bytecode caches are the interpreter's and stay."""
    shutil.copytree(src, dst, dirs_exist_ok=True)
    for f in sorted(dst.rglob("*"), reverse=True):
        rel = f.relative_to(dst)
        if "__pycache__" in rel.parts or (src / rel).exists():
            continue
        if f.is_symlink():
            f.unlink()      # a link, never its target
        elif f.is_dir():
            if not any(f.iterdir()):
                f.rmdir()
        else:
            f.unlink()


def _plugin_dir() -> pathlib.Path:
    return (config.HOME / ".config" / "omarchy" / "plugins"
            / "io.github.duketopceo.wisp")


def _preflight_install_path(path: pathlib.Path, directory: bool = False) -> None:
    """Refuse file/directory collisions without deleting existing user content."""
    for parent in reversed(path.parents):
        if parent.exists() and not parent.is_dir():
            raise ValueError(f"Install path conflict: {parent} must be a directory; "
                             "nothing was installed.")
    if path.exists() and (not path.is_dir() if directory else not path.is_file()):
        kind = "directory" if directory else "regular file"
        raise ValueError(f"Install path conflict: {path} must be a {kind}; "
                         "nothing was installed.")


def _preflight_install_tree(src: pathlib.Path, dst: pathlib.Path) -> None:
    _preflight_install_path(dst, directory=src.is_dir())
    if src.is_dir():
        for child in src.iterdir():
            _preflight_install_tree(child, dst / child.name)


def install_files(dry_run: bool = False, cfg: dict | None = None,
                  src: pathlib.Path | None = None,
                  deploy: dict | None = None,
                  plugin: bool = True) -> None:
    """Copy runtime files to the opt dir, write the trigger shim and
    service registration, and install the shell plugin directory.
    `src` is a pre-exported source tree (`install --ref`); `deploy` is
    its {repo, ref, commit} for the record (default: this checkout).
    `plugin=False` leaves the shell plugin directory alone: it arrived
    from the Omarchy marketplace (`omarchy plugin add`, a git checkout
    that `omarchy plugin update` owns)."""
    src = src or pathlib.Path(__file__).resolve().parent
    opt = config.HOME / ".local" / "opt" / "wisp"
    from wisp import update as _update
    plugin = plugin and _update.plugin_managed(config.HOME, opt)
    if src == opt:
        # invoked via the ~/.local/bin symlink → __file__ resolves to
        # the installed copy; copytree would self-copy and silently
        # stay stale. Point the user at the real checkout instead.
        print("wispd install must run from the source checkout "
              "(python3 wispd install) — this wispd IS the installed "
              "copy; nothing updated")
        return
    # Validate mandatory archive inputs before the first HOME mutation.
    for rel in ("wispd", "wisp", "assets/desktop/wisp.desktop",
                "scripts/units/wispd.service"):
        if not (src / rel).exists():
            raise ValueError(f"Incomplete Wisp source: missing {rel}; "
                             "nothing was installed.")
    targets = [opt, config.HOME / ".local/bin/wispd",
               config.HOME / ".local/bin/wisp-trigger",
               config.HOME / ".local/share/applications/wisp.desktop",
               config.HOME / ".config/systemd/user",
               config.HOME / ".config/hypr/bindings.lua",
               config.HOME / ".config/hypr/hyprland.conf"]
    if plugin:
        targets.append(_plugin_dir())
    icon_root = src / "assets/icons/hicolor"
    if icon_root.is_dir():
        targets.extend(config.HOME / ".local/share/icons/hicolor"
                       / f.relative_to(icon_root) for f in icon_root.rglob("*")
                       if f.is_file())
    for target in targets:
        _desktop.refuse_links(target, tree=target in (opt, _plugin_dir()))
        _preflight_install_path(
            target, directory=target in (
                opt, _plugin_dir(), config.HOME / ".config/systemd/user"))
    # Check the whole destination shape before plugin-mode or any runtime copy.
    # copytree/copy2 otherwise fail late or redirect a file into an existing dir.
    for rel in ("wisp", "shells", "assets", "bin", "scripts/units",
                "scripts/cua", "scripts/bootstrap", "docs"):
        if (src / rel).is_dir():
            _preflight_install_tree(src / rel, opt / rel)
    for rel in ("wispd", "scripts/build_harness.py", "scripts/fetch_whisper.sh",
                "release.json", "payload.json", "CHANGELOG.md"):
        if (src / rel).is_file():
            _preflight_install_path(opt / rel)
    for name in ("plugin-mode", "deploy.json"):
        _preflight_install_path(opt / name)
    if (src / "scripts/build_harness.py").is_file():
        _preflight_install_path(opt / "build_harness.py")
    from wisp import svc as _svc_install
    _svc_install.install_units(config.HOME, dry_run=True,
                               local=config.local_enabled(cfg),
                               units_dir=src / "scripts/units")
    plugin_plan = _update.plugin_plan(src, config.HOME, opt) if plugin else None
    if plugin_plan is not None:
        _preflight_install_path(opt / "plugin-files.json")
        for rel in plugin_plan["owned"]:
            _preflight_install_path(_plugin_dir() / rel)
    # Release metadata is part of the verified archive; validate its shape
    # before any install writes and retain its source tag/commit.
    release_deploy = None
    if (src / "release.json").is_file():
        import json
        import re
        meta = json.loads((src / "release.json").read_text())
        if not re.fullmatch(r"v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?",
                            str(meta.get("version", ""))) \
                or not re.fullmatch(r"[0-9a-f]{40}", str(meta.get("commit", ""))):
            raise ValueError("Invalid release.json version/commit; nothing installed.")
        release_deploy = {"repo": None, "ref": meta["version"],
                          "commit": meta["commit"]}
    if dry_run:
        res = _desktop.install(src, config.HOME, opt, dry_run=True)
        for f in res["written"]:
            print(f"would write {f}")
        for f in res["backups"]:
            print(f"would back up the edited file to {f}")
        if plugin and (src / "shell-plugin").is_dir():
            print(f"would write {_plugin_dir()}")
        print(f"would write {opt}/ (wisp, wispd, shells, assets, bin, "
              "runtime scripts, release inventory, docs including "
              "docs/baselines and docs/dev-tasks), "
              f"{config.HOME}/.local/bin/wispd, "
              f"{config.HOME}/.local/bin/wisp-trigger and the systemd user unit(s)")
        print("dry run: nothing written")
        return
    opt.mkdir(parents=True, exist_ok=True)
    (opt / "plugin-mode").write_text("managed\n" if plugin else "marketplace\n")
    pkg = src / "wisp"
    if pkg.is_dir():
        _mirror(pkg, opt / "wisp")
        print(f"installed {opt}/wisp")
    for name in ("wispd",):
        target = opt / name
        shutil.copy2(src / name, target)
        target.chmod(0o755)
        print(f"installed {target}")
    for extra in ("scripts/build_harness.py", "CHANGELOG.md"):
        f = src / extra
        if f.exists():
            shutil.copy2(f, opt / f.name)
            print(f"installed {opt}/{f.name}")
    shells_src = src / "shells"
    if shells_src.is_dir():
        _mirror(shells_src, opt / "shells")
        print(f"installed {opt}/shells")
    # Retain runtime resources at the paths modules resolve relative to opt.
    # Do not copy the whole source tree (which could contain local secrets).
    for rel in ("assets", "bin", "scripts/units", "scripts/cua",
                "scripts/bootstrap", "docs"):
        if (src / rel).is_dir():
            _mirror(src / rel, opt / rel)
    for rel in ("scripts/build_harness.py", "scripts/fetch_whisper.sh",
                "release.json", "payload.json"):
        if (src / rel).is_file():
            (opt / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src / rel, opt / rel)
    res = _desktop.install(src, config.HOME, opt)
    for f in res["backups"]:
        print(f"backed up edited desktop file to {f}")
    print(f"installed desktop entry + icons ({len(res['written'])} "
          "files changed)")
    for t in res["skipped"]:
        print(f"skipped {t} (not found)")
    plugin_src = src / "shell-plugin"
    plugin_dst = _plugin_dir()
    if plugin and plugin_src.is_dir():
        # Unlike the core package, this directory may contain user additions.
        # Never prune unowned files or nested user content.
        for rel in plugin_plan["owned"]:
            target = plugin_dst / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(plugin_src / rel, target)
        for rel in plugin_plan["kept"]:
            print(f"kept edited plugin file {rel}")
        (opt / "plugin-files.json").write_bytes(_update.plugin_record(plugin_plan))
        print(f"installed {plugin_dst}")
    import shlex
    trigger = config.HOME / ".local" / "bin" / "wisp-trigger"
    trigger.parent.mkdir(parents=True, exist_ok=True)
    trigger.write_text("#!/bin/sh\nexec " + shlex.quote(sys.executable)
                       + " " + shlex.quote(str(opt / "wispd")) + ' trigger "$@"\n')
    trigger.chmod(0o755)
    print(f"installed {trigger}")
    launcher = trigger.with_name("wispd")
    launcher.write_text("#!/bin/sh\nexec " + shlex.quote(sys.executable)
                        + " " + shlex.quote(str(opt / "wispd")) + ' "$@"\n')
    launcher.chmod(0o755)
    print(f"installed {launcher}")
    from wisp import deploy as _deploy, svc
    # templates come from the tree being installed: the installed copy has
    # no scripts/, and an exported ref must not get this checkout's units
    acts = svc.install_units(config.HOME, local=config.local_enabled(cfg),
                             units_dir=src / "scripts" / "units")
    print(svc.describe(acts))
    # recorded last, so a failed install never claims its commit
    d = deploy or release_deploy or {"repo": src, "ref": None,
                   "commit": _deploy.head_commit(src)}
    _deploy.write(d["repo"], d["ref"], d["commit"])
    print(f"recorded deploy {(d['commit'] or 'unknown')[:12]}")
    print("units installed, not restarted; apply with systemctl --user "
          "restart <unit>")


def install_bind(cfg: dict, dry_run: bool = False) -> None:
    """Idempotently add the push-to-talk bind and the rate-wrong bind to
    ~/.config/hypr/bindings.lua."""
    _install_ptt_bind(cfg, dry_run)
    _install_rate_bind(cfg, dry_run)


def _install_rate_bind(cfg: dict, dry_run: bool = False) -> None:
    """Idempotently add `MOD + ALT + KEY` (default Super+Alt+D): rate
    the last finished turn wrong and open the panel's note (U2). Omarchy
    already binds Super+Shift+D (Docker), Super+Ctrl+D and
    Super+Ctrl+Alt+D; a mod that already holds ALT takes CTRL instead."""
    from wisp import platform
    if not platform.supports_hotkey_install():
        return
    mod = cfg.get("hotkey", {}).get("mod", "SUPER")
    key = cfg.get("hotkey", {}).get("key", "D")
    extra = "CTRL" if "ALT" in mod.upper() else "ALT"
    combo = f"{mod} + {extra} + {key.upper()}"
    cmd = f"{config.HOME}/.local/bin/wispd label set incorrect"
    bind = (f'o.bind("{combo}", "Wisp rate last answer wrong", '
            f'{{ launch = "{cmd}" }})')
    bindings = config.HOME / ".config" / "hypr" / "bindings.lua"
    if not bindings.parent.is_dir():
        return
    text = bindings.read_text() if bindings.exists() else ""
    if "label set incorrect" in text:
        print(f"rate bind already present in {bindings}")
        return
    if dry_run:
        print(f"would add to {bindings}:\n  {bind}")
        return
    with bindings.open("a") as f:
        f.write(f"\n-- Wisp rate last answer wrong\n{bind}\n")
    print(f"added rate bind to {bindings}: {bind}")
    subprocess.run(["hyprctl", "reload"], env=pipeline.hypr_env(),
                   capture_output=True)


def _install_ptt_bind(cfg: dict, dry_run: bool = False) -> None:
    """Idempotently add the push-to-talk bind to ~/.config/hypr/bindings.lua.
    With `dry_run` it prints what it would do and writes nothing.

    Omarchy configures Hyprland in Lua; hyprland.conf is not sourced, so a
    `bind =` line there is dead. Legacy installs wrote one — strip it.
    """
    from wisp import platform
    if not platform.supports_hotkey_install():
        print("hotkey install writes a Hyprland bind only — on GNOME/KDE "
              "bind push-to-talk to `wispd listen` in the desktop's "
              "keyboard shortcut settings")
        return
    mod = cfg.get("hotkey", {}).get("mod", "SUPER")
    key = cfg.get("hotkey", {}).get("key", "D")
    trigger = f"{config.HOME}/.local/bin/wisp-trigger"
    bind = (f'o.bind("{mod} + {key.upper()}", "Wisp push-to-talk (hold)", '
            f'{{ launch = "{trigger} start" }})\n'
            f'o.bind("{mod} + {key.upper()}", "Wisp push-to-talk (release)", '
            f'{{ launch = "{trigger} stop" }}, {{ release = true }})')

    conf = config.HOME / ".config" / "hypr" / "hyprland.conf"
    if conf.exists() and "wisp-trigger" in conf.read_text():
        if dry_run:
            print(f"would remove the dead wisp bind from {conf} "
                  "(not sourced under Lua)")
        else:
            lines = [l for l in conf.read_text().splitlines()
                     if "wisp-trigger" not in l
                     and l.strip() != "# Wisp push-to-talk"]
            conf.write_text("\n".join(lines) + "\n")
            print("removed dead bind from hyprland.conf "
                  "(not sourced under Lua)")

    bindings = config.HOME / ".config" / "hypr" / "bindings.lua"
    if not bindings.parent.is_dir():
        print("no ~/.config/hypr, " + ("would skip" if dry_run else "skipped")
              + " the hotkey bind")
        return
    text = bindings.read_text() if bindings.exists() else ""
    target_combo = f"{mod} + {key.upper()}"
    conflicts = [l.strip() for l in text.splitlines()
                 if target_combo in l.upper() and "wisp-trigger" not in l
                 and not l.lstrip().startswith("--")]
    if conflicts:
        print(f"⚠️  WARNING: Hotkey {target_combo} is already in use in {bindings}:")
        for c in conflicts[:2]:
            print(f"   {c}")
        print("💡 Recommended alternative hotkeys without conflicts: SUPER + SPACE, ALT + D, F13")
        print("   Configure [hotkey] in ~/.config/wisp/config.toml to override.")

    old = [l for l in text.splitlines() if "wisp-trigger" in l]
    if (len(old) >= 2
            and all("start" in l or "release" in l for l in old)):
        print(f"bind already present in {bindings}")
        return
    if dry_run:
        print(f"would add to {bindings}:")
        for line in bind.splitlines():
            print(f"  {line}")
        return
    if old:  # stale toggle-style bind — replace with press/release pair
        text = "\n".join(l for l in text.splitlines()
                         if "wisp-trigger" not in l
                         and l.strip() != "-- Wisp push-to-talk")
        bindings.write_text(text.rstrip("\n") + "\n")
    with bindings.open("a") as f:
        f.write(f"\n-- Wisp push-to-talk\n{bind}\n")
    print(f"added bind to {bindings}: {bind}")
    subprocess.run(["hyprctl", "reload"], env=pipeline.hypr_env(),
                   capture_output=True)


def _doctor(cfg: dict) -> int:
    """Scan everything wispd depends on — the harness/runtime probe."""
    import shutil as _sh
    from wisp import agents, brain, skills
    ok = True

    def row(name, val, good=True):
        nonlocal ok
        ok = ok and good
        print(f"  {'ok ' if good else 'MISS'} {name:<22} {val}")

    print("agent runtimes:")
    found = agents.detect_runtimes()
    chosen = agents.resolve_runtime(cfg)
    for rt in ("opencode", "codex", "claude", "devin"):
        mark = " (selected)" if rt == chosen else ""
        if rt in found:
            row(rt, found[rt] + mark)
        else:
            # a missing runtime only fails doctor when it's the
            # explicitly configured one — auto falls back
            row(rt, f"not on PATH{mark}",
                good=(rt != chosen or not mark))
    if cfg.get("brain", {}).get("agent_runtime", "auto") == "auto" \
            and not chosen:
        print("  !! agent_runtime=auto but nothing detected")
        ok = False
    from wisp.cli import diagnose as _diagnose
    _diagnose._agent_rows(row)

    print("install preflight:")
    from wisp import preflight as _pf
    for r in _pf.run():
        row(r["id"], r["detail"], good=r["level"] != "block")

    print("stt / audio:")
    from wisp import platform as _plat
    wm = config.whisper_model(cfg)
    stt = config.stt_settings(cfg)["provider"]
    # whisper.cpp is opt-in; hosted STT needs no local model
    row("whisper model", wm.name, good=stt != "local" or wm.exists())
    row("stt provider", stt)
    for b in ("pw-record", "wtype", "grim"):
        row(b, _sh.which(b) or "", good=bool(_sh.which(b)))

    print("brain / router:")
    p = brain.provider(cfg)
    row("answer provider", f"{p['name']}:{p['model']}")
    row("vision", p.get("vision"))
    row("tools", p.get("tools"))
    key = config.load_env_key(p.get("key_env", "")) \
        if p.get("key_env") else "n/a"
    row("api key", "set" if key == "set" or (key and key != "n/a")
        else key or "MISSING", good=bool(key))

    print("health (local endpoints, 500 ms probes):")
    from wisp import health as _health
    reg = _health.HealthRegistry(cfg)
    snap = reg.probe_all()
    if not snap:
        row("endpoints", "none local to probe")
    for name, h in snap.items():
        row(name, f"{h['latency_ms']} ms" if h["ok"]
            else f"DOWN ({h['code']})", good=h["ok"])

    print("pointer:")
    pb = _plat.pointer_backend(cfg)
    mode = cfg.get("pointer", {}).get("mode", "guide")
    row("pointer backend", pb or "none — guide mode only")
    row("pointer mode", mode)

    print("integrations:")
    row("dayflow", _sh.which("dayflow") or "not installed",
        good=bool(_sh.which("dayflow")))
    row("codegraph (CBM)", _sh.which("codebase-memory-mcp")
        or "not installed")
    row("hyprctl", _sh.which("hyprctl") or "",
        good=bool(_sh.which("hyprctl"))
        or _plat.current() != "linux")
    row("sense enabled", cfg.get("sense", {}).get("enabled", "false"))

    print("data:")
    row("skills", str(len(skills.index())) + " installed")
    for f in ("decisions.jsonl", "labels.jsonl", "activity.jsonl"):
        fp = config.DATA_DIR / f
        row(f, f"{fp.stat().st_size // 1024}KB" if fp.exists()
            else "absent", good=True)
    return 0 if ok else 1


def _models(cfg: dict, args: list) -> int:
    """`wispd models` shows local endpoint health. `wispd models start`
    PRINTS the systemctl command for the units behind down endpoints;
    only `--run` executes it (explicit request, user-scope units)."""
    from wisp import health as _health
    snap = _health.HealthRegistry(cfg).probe_all()
    if not args:
        if not snap:
            print("no local endpoints configured")
        for name, h in snap.items():
            print(f"{'ok  ' if h['ok'] else 'DOWN'} {name:<16} "
                  + (f"{h['latency_ms']} ms" if h["ok"] else h["code"]))
        return 0
    if args[0] != "start":
        print("usage: wispd models [start [--run]]", file=sys.stderr)
        return 2
    units = _health.units_to_start(cfg, snap)
    if not units:
        print("nothing to start (no down endpoint has units in "
              "[health.units])")
        return 0
    cmd = _health.start_command(units)
    if "--run" not in args:
        print(" ".join(cmd))
        print("(dry run — add --run to execute)")
        return 0
    return subprocess.run(cmd).returncode


def rebuild_harness() -> int:
    candidates = [
        config.DATA_DIR / "opt" / "wisp" / "build_harness.py",
        config.HOME / ".local" / "opt" / "wisp" / "build_harness.py",
    ]
    builder = next((c for c in candidates if c.exists()),
                   pathlib.Path(__file__).resolve().parent
                   / "scripts" / "build_harness.py")
    return subprocess.run([sys.executable, str(builder)]).returncode


def _agent_mcp() -> int:
    """Hidden `wispd agent-mcp`: the MCP stdio bridge OpenCode launches
    (U8). The session token arrives in WISP_MCP_TOKEN, never argv."""
    from wisp import agent_mcp
    token = os.environ.get("WISP_MCP_TOKEN", "")
    if not token:
        print("wispd agent-mcp: WISP_MCP_TOKEN not set", file=sys.stderr)
        return 2
    cfg = config.load_config()
    wait = agent_mcp.ask_timeout_s(cfg) + 15
    agent_mcp.serve(sys.stdin, sys.stdout,
                    lambda c: ipc.send(c, timeout=wait), token, cfg)
    return 0


def main() -> int:
    if sys.argv[1:2] == ["agent-mcp"]:
        return _agent_mcp()
    from wisp import cli, ledger
    ledger.ACTIVE = True  # real runs record usage; library use does not
    return cli.main(sys.argv[1:], host=sys.modules[__name__])


if __name__ == "__main__":
    sys.exit(main())
