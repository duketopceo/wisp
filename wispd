#!/usr/bin/env python3
"""wispd — Wisp: resident voice assistant daemon for Omarchy.

`wispd daemon` runs the IPC server (systemd user service). `wispd trigger`
is the push-to-talk client the Hyprland bind executes — it sends `listen`
to the running daemon, or runs the pipeline inline when no daemon is up.
Other subcommands: status, stop, install, harness.
"""
import datetime
import pathlib
import shutil
import signal
import subprocess
import sys
import threading
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from wisp import cancel, config, ipc, pipeline, speech, state as state_mod, trace as _trace  # noqa: E402

# daemon-scoped handles the rec watchdog needs (set in run_daemon)
_DAEMON_ST = None
_DAEMON_CFG = None
_DAEMON_CTL = None

_POLL_CMDS = {"task_status", "status"}  # widget pollers — keep out of trace


_DLOG_MAX_BYTES = 2 * 1024 * 1024


def dlog(msg: str) -> None:
    """Human-readable daemon log: ~/.local/share/wisp/wispd.log + journal."""
    now = datetime.datetime.now()
    line = f"{now:%Y-%m-%d %H:%M:%S}.{now.microsecond // 1000:03d} {msg}"
    try:
        config.DATA_DIR.mkdir(parents=True, exist_ok=True)
        fp = config.DATA_DIR / "wispd.log"
        if fp.exists() and fp.stat().st_size > _DLOG_MAX_BYTES:
            fp.replace(fp.with_suffix(".1.log"))
        with fp.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line, flush=True)


def _handler(st: state_mod.StateBus, cfg: dict, ctl: dict) -> callable:
    def handle(cmd: dict) -> dict:
        c = cmd.get("cmd")
        _t0 = __import__("time").monotonic()
        from wisp import trace as _trace
        out = _dispatch(c, cmd)
        dlog(f"ipc {c} phase={cmd.get('phase', '-')} ok={out.get('ok')}"
             + (f" err={out.get('error')}" if not out.get("ok") else ""))
        if c not in _POLL_CMDS:
            _trace.emit("sys", "ipc", "ipc",
                        {"cmd": c, "ok": out.get("ok")},
                        round((__import__("time").monotonic() - _t0) * 1000))
        return out

    def _dispatch(c: str, cmd: dict) -> dict:
        if c == "status":
            from wisp import agents
            agents.reap(cfg)  # zombie + timeout watchdog on each poll
            cur = agents.tasks()
            # long-running agent completion: notify once on the
            # running → done transition
            done = agents.finished(getattr(st, "_prev_tasks", {}), cur)
            st._prev_tasks = cur
            st.publish(None, tasks=cur)  # daemon-level: no turn
            for t in done:
                tail = (t.get("tail") or "")[:80]
                from wisp.tools import system as _sys
                _sys.notify_tool(
                    f"wisp agent '{t['name']}' {t['status']}"
                    + (f" — {tail}" if tail else ""))
            return {"ok": True, "state": st.snapshot()}
        if c == "listen":
            phase = cmd.get("phase", "")  # hold-to-talk: start|stop; empty = toggle
            # U1: this request's start (client t0 when sent) — the press
            # origin on a start, the key-up instant on a stop
            req_sp = _trace.Spans(t0_ns=cmd.get("t0"))
            if phase in ("", "start") and _HEALTH is not None:
                # refresh endpoint health off the hot path (U7)
                threading.Thread(target=_HEALTH.on_press,
                                 daemon=True).start()
            with ctl["rec_lock"]:
                if phase == "start" and ctl["rec"] is not None:
                    return {"ok": True, "recording": True}
                if phase == "stop" and ctl["rec"] is None:
                    return {"ok": True, "stopped": True}
                if ctl["rec"] is not None:
                    # second press / release: stop capture, run the pipeline
                    rec = ctl["rec"]
                    ctl["rec"] = None
                    held = time.monotonic() - rec.get("t0", 0)
                    if held < 0.4:
                        # phantom release or key-repeat bounce — too short to
                        # mean anything; kill the recorder and settle quietly
                        try:
                            rec["proc"].send_signal(signal.SIGINT)
                            rec["proc"].wait(timeout=2)
                        except Exception:
                            rec["proc"].kill()
                        rec["sampler_stop"].set()
                        st.turn(ctl.pop("turn", None)
                                or st.current_turn()).transition(
                            "done", result="", transcript="")
                        dlog(f"listen: {held * 1000:.0f}ms capture "
                             "ignored (phantom)")
                        return {"ok": True, "stopped": True,
                                "ignored": True}
                    if ctl["busy"].is_set():
                        return {"ok": False, "error": "busy"}
                    tid = ctl.pop("turn", None) or st.current_turn()
                    try:
                        wav = pipeline.record_stop(rec, st.turn(tid))
                    except RuntimeError as e:
                        st.turn(tid).transition("error", error=str(e))
                        return {"ok": False, "error": str(e)}
                    ctl["busy"].set()
                    sp = ctl.pop("spans", None) or _trace.Spans()
                    sp.adopt_release(req_sp)
                    threading.Thread(
                        target=_run_listen,
                        args=(st, cfg, ctl, wav, sp, tid),
                        daemon=True).start()
                    return {"ok": True, "stopped": True}
                if ctl["busy"].is_set():
                    return {"ok": False, "error": "busy"}
                # first press: start open-ended capture; [audio] seconds
                # is the safety cap, not the length.
                speech.stop()
                # a new turn: anything the previous turn still has in
                # flight (TTS exit callback, level sampler) is stale now
                tid = st.begin_turn()
                ctl["turn"] = tid
                ctl["interrupt"].clear()
                ctl["token"] = cancel.CancelToken()
                th = st.turn(tid)
                th.transition("listening", transcript="", result="",
                              answer="", choices=[], points=[], error="",
                              steps=[], guide=None)
                req_sp.record("press", req_sp.t0)
                try:
                    ctl["rec"] = pipeline.record_start(th)
                except RuntimeError as e:
                    th.transition("error", error=str(e))
                    return {"ok": False, "error": str(e)}
                ctl["spans"] = req_sp
                secs = int(cfg.get("audio", {}).get("seconds", "60"))
                threading.Thread(target=_rec_watchdog,
                                 args=(ctl, secs), daemon=True).start()
                return {"ok": True, "recording": True}
        if c == "choice":
            pick = cmd.get("pick", "")
            if pick.startswith("suggestion:"):
                # suggestion card answer — resolve locally, don't wake a
                # turn's clarify waiter
                from wisp import suggest
                out = suggest.resolve_pick(pick, cfg, state=st,
                                           log=dlog)
                if out.startswith("RUN "):
                    # approved: run the routine through the act loop,
                    # fully gated; guard the busy flag like a listen turn
                    if ctl["busy"].is_set():
                        return {"ok": False, "error": "busy"}
                    ctl["busy"].set()
                    threading.Thread(
                        target=_run_suggestion,
                        args=(st, cfg, ctl, out[4:]),
                        daemon=True).start()
                    return {"ok": True, "result": "automating"}
                if not ctl["busy"].is_set():
                    st.transition("done", result=out, choices=[],
                                  suggestion=None, guide=None)  # daemon-level
                return {"ok": True, "result": out}
            broker = ctl.get("broker")
            if broker is None:  # no prompt registry (bare test handles)
                ctl["choice_pick"] = pick
                ctl["choice_event"].set()
                return {"ok": True}
            idx = cmd.get("index")
            try:
                idx = None if idx is None else int(idx)
            except (TypeError, ValueError):
                return {"ok": False, "error": "bad_index"}
            return broker.offer(pick=pick, prompt_id=cmd.get("prompt_id"),
                                index=idx)
        if c == "suggestions":
            from wisp import suggest
            return {"ok": True,
                    "suggestions": suggest.pending()}
        if c == "task_status":
            from wisp import agents
            return {"ok": True, "result": agents.status(cmd.get("name", ""))}
        if c == "task_cancel":
            from wisp import agents
            return {"ok": True, "result": agents.cancel(cmd.get("name", ""))}
        if c == "agent":
            from wisp import agents
            return {"ok": True,
                    "result": agents.spawn(cmd.get("task", ""), cfg)}
        if c == "memory":
            from wisp import memory
            if "body" in cmd:  # GUI whole-doc write — pipes/newlines safe
                return {"ok": True, "result": memory.edit(
                    cmd.get("target", "memory"), "write",
                    "", cmd.get("body", ""))}
            return {"ok": True,
                    "result": memory.run(cmd.get("arg", ""))}
        if c == "label":
            from wisp import learn
            return {"ok": True,
                    "result": learn.label_last(cmd.get("label", ""),
                                               cmd.get("note", ""))}
        if c == "learn":
            from wisp import learn
            p = learn.weekly(7)
            return {"ok": True,
                    "result": p if p else "nothing to propose"}
        if c == "harness":
            try:
                rc = rebuild_harness()
                return {"ok": rc == 0,
                        "result": "harness rebuilt" if rc == 0
                                  else f"builder exited {rc}"}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "config":
            set_fields = cmd.get("set") or {}
            for k, v in set_fields.items():
                section, _, key = k.rpartition(".")
                if not section or not key:
                    return {"ok": False, "error": "config keys must be section.key"}
                try:
                    config.set_config(section, key, str(v))
                except ValueError as e:
                    return {"ok": False, "error": str(e)}
            if set_fields:  # live-reload
                cfg.clear()
                cfg.update(config.load_config())
            return {"ok": True, "config": cfg}
        if c == "interrupt":
            # cancel the in-flight turn only — daemon keeps running
            ctl["interrupt"].set()
            tok = ctl.get("token")
            if tok is not None:
                tok.cancel()  # kills children, closes sockets (U9)
            speech.stop()
            return {"ok": True}
        if c == "context":
            from wisp import context as _ctx
            try:
                return {"ok": True, "result": _ctx.snapshot(cfg)}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "stop":
            speech.stop()
            ctl["stop"].set()
            return {"ok": True}
        return {"ok": False, "error": f"unknown cmd {c!r}"}
    return handle


def _choice_cmd(args: list):
    """`wispd choice` argv -> IPC message, None on a malformed call.
    `[pick] [--prompt-id ID] [--index N]` (1-based option index)."""
    msg = {"cmd": "choice", "pick": ""}
    it = iter(args)
    for a in it:
        if a.startswith("--prompt-id"):
            val = a.partition("=")[2] or next(it, "")
            if not val:
                return None
            msg["prompt_id"] = val
        elif a.startswith("--index"):
            val = a.partition("=")[2] or next(it, "")
            try:
                msg["index"] = int(val)
            except ValueError:
                return None
        else:
            msg["pick"] = a
    return msg


def _wait_for_choice(ctl: dict, token=None):
    """Prompt waiter for one turn: `wait(timeout, prompt_id=, options=)`
    blocks until a matching `choice` arrives (see cancel.PromptBroker)."""
    broker = ctl.get("broker")
    if broker is None:
        broker = ctl["broker"] = cancel.PromptBroker()
    return broker.waiter(token)


def _rec_watchdog(ctl: dict, secs: int) -> None:
    """Safety cap: auto-stop an open capture after [audio] seconds."""
    ctl["stop"].wait(secs)
    with ctl["rec_lock"]:
        rec = ctl["rec"]
        if rec is None:
            return
        ctl["rec"] = None
    # mimic a second press: finish capture, hand wav to the pipeline —
    # state/cfg fetched at call time via the closure the daemon holds
    try:
        tid = _DAEMON_CTL.pop("turn", None) or _DAEMON_ST.current_turn()
        wav = pipeline.record_stop(rec, _DAEMON_ST.turn(tid))
        _DAEMON_CTL["busy"].set()
        threading.Thread(
            target=_run_listen,
            args=(_DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL, wav, None, tid),
            daemon=True).start()
    except RuntimeError as e:
        _DAEMON_ST.transition("error", error=str(e))


def _run_listen(st: state_mod.StateBus, cfg: dict, ctl: dict,
                wav=None, spans=None, turn_id=None) -> None:
    turn_id = turn_id or st.current_turn()
    token = ctl.get("token")
    if token is None:
        token = ctl["token"] = cancel.CancelToken()
    try:
        pipeline.run_listen(cfg, st,
                            wait_for_choice=_wait_for_choice(ctl, token),
                            interrupted=ctl["interrupt"].is_set,
                            wav=wav, spans=spans, turn_id=turn_id,
                            cancel=token)
        dlog(f"turn done: status={st.status} "
             f"transcript={st.transcript!r} result={st.result!r}")
    except Exception as e:
        dlog(f"turn error: {e}")
        try:
            pipeline._publish_error(st.turn(turn_id), e)
        except Exception:
            pass
    finally:
        ctl["busy"].clear()


def _run_suggestion(st, cfg, ctl, routine: str) -> None:
    """Approved suggestion → bounded act loop (all gates apply)."""
    from wisp import act
    th = st.turn(st.begin_turn())
    try:
        th.transition("acting", transcript="", choices=[],
                      suggestion=None, steps=[],
                      result="automating suggestion")
        out = act.run_act_loop(routine, cfg, state=th,
                               confirm=None)  # no re-confirm loop;
        # mutating steps skip rather than hang on a card
        th.transition("done", result=out, guide=None)
        dlog(f"suggestion run done: {out!r}")
    except Exception as e:
        dlog(f"suggestion run error: {e}")
        th.transition("error", error=str(e))
    finally:
        ctl["busy"].clear()


_HEALTH = None  # health.HealthRegistry while the daemon runs (U7)


def _hypr_health() -> dict:
    """Registry hook for the Hyprland socket (U5). Re-probes, since
    hypr.health() only reports the last remembered state."""
    from wisp import hypr, platform
    if not platform.uses_hypr():
        return {"ok": True, "code": None, "skipped": True}
    hypr.probe()
    return hypr.health()


def run_daemon(cfg: dict) -> int:
    global _DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL, _HEALTH
    from wisp import skills, theme, memory as _memory
    skills.register_tools()  # skill_<name> entries from skills/*/SKILL.md
    skills.seed()          # bundled dayflow-bridge/self-checkup skills
    skills.write_index_json()  # panel reads this without spawning IPC
    theme.emit(cfg)        # theme.json for the QML surfaces
    dlog(_memory.sync_constitution())  # luke-agents -> MEMORY.md block
    from wisp import inventory as _inv
    if not _inv.fresh():
        inv = _inv.scan(cfg)
        dlog(f"inventory: {len(inv.get('apps', []))} apps, "
             f"{len(inv.get('cli_tools', {}))} cli tools")
    st = state_mod.StateBus()
    ctl = {"stop": threading.Event(), "busy": threading.Event(),
           "interrupt": threading.Event(),
           "choice_event": threading.Event(), "choice_pick": "",
           "broker": cancel.PromptBroker(), "token": None,
           "rec": None, "rec_lock": threading.Lock()}
    _DAEMON_ST, _DAEMON_CFG, _DAEMON_CTL = st, cfg, ctl
    if cfg.get("health", {}).get("enabled", "true") == "true":
        from wisp import brain as _brain, health as _health
        _HEALTH = _health.HealthRegistry(cfg, bus=st)
        _HEALTH.register("hypr", _hypr_health)
        _brain.HEALTH = _HEALTH
        _HEALTH.start()
    server = ipc.Daemon(_handler(st, cfg, ctl))
    server.start()
    dlog(f"wispd up — socket {config.SOCK_FILE} "
         f"log {config.DATA_DIR / 'wispd.log'}")
    # sense + suggest threads — opt-in via [sense] enabled; each loop is
    # single-flight and self-contained, so nothing can run away
    from wisp import sense, suggest
    if sense.enabled(cfg):
        threading.Thread(target=sense.run,
                         args=(cfg, ctl["stop"]),
                         kwargs={"log": dlog}, daemon=True).start()
        threading.Thread(target=suggest.run,
                         args=(cfg, ctl["stop"]),
                         kwargs={"state": st, "log": dlog},
                         daemon=True).start()
        dlog("sense: enabled "
             f"(tick={cfg.get('sense', {}).get('interval_s', '300')}s, "
             f"mine={cfg.get('sense', {}).get('mine_every_s', '2700')}s)")
    try:
        ctl["stop"].wait()
    except KeyboardInterrupt:
        pass
    finally:
        if _HEALTH is not None:
            _HEALTH.stop()
        server.stop()
        st.transition("idle")
        st.close()
    return 0


def cmd_trigger(cfg: dict, phase: str = "") -> int:
    try:
        resp = ipc.send({"cmd": "listen", "phase": phase,
                         "t0": time.time_ns()})
        if resp.get("ok"):
            return 0
        print(f"wispd: {resp.get('error')}", file=sys.stderr)
        return 1
    except (ConnectionError, OSError):
        # No daemon: run the pipeline inline so the bind still works
        # before the systemd unit is installed/enabled.
        st = state_mod.StateBus()
        try:
            return pipeline.run_listen(cfg, st)
        finally:
            st.close()


def install_files() -> None:
    """Copy runtime files to ~/.local/opt/wisp, write the trigger shim
    and the systemd user unit, and install the shell plugin directory."""
    src = pathlib.Path(__file__).resolve().parent
    opt = config.HOME / ".local" / "opt" / "wisp"
    if src == opt:
        # invoked via the ~/.local/bin symlink → __file__ resolves to
        # the installed copy; copytree would self-copy and silently
        # stay stale. Point the user at the real checkout instead.
        print("wispd install must run from the source checkout "
              "(python3 wispd install) — this wispd IS the installed "
              "copy; nothing updated")
        return
    opt.mkdir(parents=True, exist_ok=True)
    pkg = src / "wisp"
    if pkg.is_dir():
        shutil.copytree(pkg, opt / "wisp", dirs_exist_ok=True)
        print(f"installed {opt}/wisp")
    for name in ("wispd",):
        target = opt / name
        shutil.copy2(src / name, target)
        target.chmod(0o755)
        print(f"installed {target}")
    for extra in ("scripts/build_harness.py",):
        f = src / extra
        if f.exists():
            shutil.copy2(f, opt / f.name)
            print(f"installed {opt}/{f.name}")
    shells_src = src / "shells"
    if shells_src.is_dir():
        shutil.copytree(shells_src, opt / "shells", dirs_exist_ok=True)
        print(f"installed {opt}/shells")
    desktop = (config.HOME / ".local" / "share" / "applications"
               / "wisp.desktop")
    desktop.parent.mkdir(parents=True, exist_ok=True)
    desktop.write_text(f"""\
[Desktop Entry]
Type=Application
Name=Wisp
GenericName=Voice Assistant
Comment=Wisp voice assistant — management console
Exec=quickshell -n -p {opt}/shells/debug
Icon=wisp
Terminal=false
Categories=Utility;Accessibility;
Keywords=voice;assistant;ai;wisp;
StartupNotify=false
""")
    print(f"installed {desktop}")
    icons_src = src / "assets" / "icons" / "hicolor"
    if icons_src.is_dir():
        icons_dst = config.HOME / ".local" / "share" / "icons" / "hicolor"
        shutil.copytree(icons_src, icons_dst, dirs_exist_ok=True)
        print(f"installed {icons_dst}")
    plugin_src = src / "shell-plugin"
    plugin_dst = (config.HOME / ".config" / "omarchy" / "plugins"
                  / "io.github.duketopceo.wisp")
    if plugin_src.is_dir():
        shutil.copytree(plugin_src, plugin_dst, dirs_exist_ok=True)
        # an old installer copied the directory itself — sweep the
        # stale nested copy so there's exactly one QML source of truth
        shutil.rmtree(plugin_dst / "shell-plugin", ignore_errors=True)
        print(f"installed {plugin_dst}")
    trigger = config.HOME / ".local" / "bin" / "wisp-trigger"
    trigger.parent.mkdir(parents=True, exist_ok=True)
    trigger.write_text(f'#!/bin/sh\nexec {sys.executable} {opt}/wispd trigger "$@"\n')
    trigger.chmod(0o755)
    print(f"installed {trigger}")
    from wisp import platform as _plat
    if _plat.current() == "windows":
        # Task Scheduler: run wispd daemon at logon (U8). The shipped
        # launcher is the extensionless Python script, so materialize a
        # .cmd wrapper that schtasks can execute directly.
        cmd = opt / "wispd.cmd"
        cmd.write_text(
            f'@echo off\r\n"{sys.executable}" "{opt / "wispd"}" %*\r\n')
        print(f"installed {cmd}")
        subprocess.run(
            ["schtasks", "/create", "/tn", "Wisp", "/sc", "onlogon",
             "/tr", f'"{cmd}" daemon', "/f"],
            capture_output=True)
        print("registered Task Scheduler task Wisp (logon)")
        return
    if _plat.current() == "macos":
        # launchd agent plist (U7)
        plist_dir = config.HOME / "Library" / "LaunchAgents"
        plist_dir.mkdir(parents=True, exist_ok=True)
        plist = plist_dir / "ai.wisp.wispd.plist"
        # launchd hands the job a minimal PATH, so brew-installed tools
        # (sox for mic capture) and a local whisper.cpp build are
        # invisible unless we say otherwise — the daemon then reports
        # "no recorder found" on a machine where sox is plainly installed.
        path = ":".join([
            str(pathlib.Path(sys.executable).parent),
            "/opt/homebrew/bin", "/usr/local/bin",
            "/usr/bin", "/bin", "/usr/sbin", "/sbin",
        ])
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>Label</key><string>ai.wisp.wispd</string>
<key>ProgramArguments</key><array>
<string>{sys.executable}</string>
<string>{opt}/wispd</string><string>daemon</string></array>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>{path}</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/></dict></plist>""")
        print(f"installed {plist} (launchctl load to activate)")
        return
    unit_dir = config.HOME / ".config" / "systemd" / "user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    unit = unit_dir / "wispd.service"
    unit.write_text(f"""\
[Unit]
Description=Wisp voice assistant daemon
After=graphical-session.target

[Service]
ExecStart={sys.executable} {opt}/wispd daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
""")
    print(f"installed {unit}")
    subprocess.run(["systemctl", "--user", "daemon-reload"],
                   capture_output=True)


def install_bind(cfg: dict) -> None:
    """Idempotently add the push-to-talk bind to ~/.config/hypr/bindings.lua.

    Omarchy configures Hyprland in Lua; hyprland.conf is not sourced, so a
    `bind =` line there is dead. Legacy installs wrote one — strip it.
    """
    from wisp import platform
    if not platform.supports_hotkey_install():
        print("hotkey install is Linux/Hyprland-only — on macOS bind "
              "push-to-talk via SKHD/Raycast/a shortcut app: "
              "`wispd listen` (see docs/MACOS.md)")
        return
    mod = cfg.get("hotkey", {}).get("mod", "SUPER")
    key = cfg.get("hotkey", {}).get("key", "D")
    trigger = f"{config.HOME}/.local/bin/wisp-trigger"
    bind = (f'o.bind("{mod} + {key.upper()}", "Wisp push-to-talk (hold)", '
            f'{{ launch = "{trigger} start" }})\n'
            f'o.bind("{mod} + {key.upper()}", "Wisp push-to-talk (release)", '
            f'{{ launch = "{trigger} stop" }}, {{ release = true }})')

    conf = config.HOME / ".config" / "hypr" / "hyprland.conf"
    if conf.exists() and "wisp-trigger" in conf.read_text():
        lines = [l for l in conf.read_text().splitlines()
                 if "wisp-trigger" not in l
                 and l.strip() != "# Wisp push-to-talk"]
        conf.write_text("\n".join(lines) + "\n")
        print("removed dead bind from hyprland.conf (not sourced under Lua)")

    bindings = config.HOME / ".config" / "hypr" / "bindings.lua"
    text = bindings.read_text() if bindings.exists() else ""
    old = [l for l in text.splitlines() if "wisp-trigger" in l]
    if (len(old) >= 2
            and all("start" in l or "release" in l for l in old)):
        print(f"bind already present in {bindings}")
        return
    if old:  # stale toggle-style bind — replace with press/release pair
        text = "\n".join(l for l in text.splitlines()
                         if "wisp-trigger" not in l
                         and l.strip() != "-- Wisp push-to-talk")
        bindings.write_text(text.rstrip("\n") + "\n")
    with bindings.open("a") as f:
        f.write(f"\n-- Wisp push-to-talk\n{bind}\n")
    print(f"added bind to {bindings}: {bind}")
    subprocess.run(["hyprctl", "reload"], env=pipeline.hypr_env(),
                   capture_output=True)


def _doctor(cfg: dict) -> int:
    """Scan everything wispd depends on — the harness/runtime probe."""
    import shutil as _sh
    from wisp import agents, brain, skills
    ok = True

    def row(name, val, good=True):
        nonlocal ok
        ok = ok and good
        print(f"  {'ok ' if good else 'MISS'} {name:<22} {val}")

    print("agent runtimes:")
    found = agents.detect_runtimes()
    chosen = agents.resolve_runtime(cfg)
    for rt in ("opencode", "codex", "claude", "devin"):
        mark = " (selected)" if rt == chosen else ""
        if rt in found:
            row(rt, found[rt] + mark)
        else:
            # a missing runtime only fails doctor when it's the
            # explicitly configured one — auto falls back
            row(rt, f"not on PATH{mark}",
                good=(rt != chosen or not mark))
    if cfg.get("brain", {}).get("agent_runtime", "auto") == "auto" \
            and not chosen:
        print("  !! agent_runtime=auto but nothing detected")
        ok = False

    print("stt / audio:")
    wm = config.whisper_model(cfg)
    row("whisper model", wm.name, good=wm.exists())
    stt = cfg.get("stt", {}).get("provider", "local")
    row("stt provider", stt)
    for b in ("pw-record", "wtype", "grim"):
        row(b, _sh.which(b) or "", good=bool(_sh.which(b)))

    print("brain / router:")
    p = brain.provider(cfg)
    row("answer provider", f"{p['name']}:{p['model']}")
    row("vision", p.get("vision"))
    row("tools", p.get("tools"))
    key = config.load_env_key(p.get("key_env", "")) \
        if p.get("key_env") else "n/a"
    row("api key", "set" if key == "set" or (key and key != "n/a")
        else key or "MISSING", good=bool(key))

    print("health (local endpoints, 500 ms probes):")
    from wisp import health as _health
    reg = _health.HealthRegistry(cfg)
    snap = reg.probe_all()
    if not snap:
        row("endpoints", "none local to probe")
    for name, h in snap.items():
        row(name, f"{h['latency_ms']} ms" if h["ok"]
            else f"DOWN ({h['code']})", good=h["ok"])

    print("pointer:")
    from wisp import platform as _plat
    pb = _plat.pointer_backend(cfg)
    mode = cfg.get("pointer", {}).get("mode", "guide")
    row("pointer backend", pb or "none — guide mode only")
    row("pointer mode", mode)

    print("integrations:")
    row("dayflow", _sh.which("dayflow") or "not installed",
        good=bool(_sh.which("dayflow")))
    row("codegraph (CBM)", _sh.which("codebase-memory-mcp")
        or "not installed")
    row("hyprctl", _sh.which("hyprctl") or "",
        good=bool(_sh.which("hyprctl")))
    row("sense enabled", cfg.get("sense", {}).get("enabled", "false"))

    print("data:")
    row("skills", str(len(skills.index())) + " installed")
    for f in ("decisions.jsonl", "labels.jsonl", "activity.jsonl"):
        fp = config.DATA_DIR / f
        row(f, f"{fp.stat().st_size // 1024}KB" if fp.exists()
            else "absent", good=True)
    return 0 if ok else 1


def _models(cfg: dict, args: list) -> int:
    """`wispd models` shows local endpoint health. `wispd models start`
    PRINTS the systemctl command for the units behind down endpoints;
    only `--run` executes it (explicit request, user-scope units)."""
    from wisp import health as _health
    snap = _health.HealthRegistry(cfg).probe_all()
    if not args:
        if not snap:
            print("no local endpoints configured")
        for name, h in snap.items():
            print(f"{'ok  ' if h['ok'] else 'DOWN'} {name:<16} "
                  + (f"{h['latency_ms']} ms" if h["ok"] else h["code"]))
        return 0
    if args[0] != "start":
        print("usage: wispd models [start [--run]]", file=sys.stderr)
        return 2
    units = _health.units_to_start(cfg, snap)
    if not units:
        print("nothing to start (no down endpoint has units in "
              "[health.units])")
        return 0
    cmd = _health.start_command(units)
    if "--run" not in args:
        print(" ".join(cmd))
        print("(dry run — add --run to execute)")
        return 0
    return subprocess.run(cmd).returncode


def rebuild_harness() -> int:
    builder = config.HOME / ".local" / "opt" / "wisp" / "build_harness.py"
    if not builder.exists():
        builder = (pathlib.Path(__file__).resolve().parent
                   / "scripts" / "build_harness.py")
    return subprocess.run([sys.executable, str(builder)]).returncode


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    cfg = config.load_config()
    if cmd == "daemon":
        return run_daemon(cfg)
    if cmd == "install":
        install_files()
        install_bind(cfg)
        return 0
    if cmd == "trigger":
        return cmd_trigger(cfg, sys.argv[2] if len(sys.argv) > 2 else "")
    if cmd == "status":
        try:
            import json
            print(json.dumps(ipc.send({"cmd": "status"}), indent=2))
            return 0
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "interrupt":
        try:
            ipc.send({"cmd": "interrupt"})
            return 0
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "stop":
        try:
            ipc.send({"cmd": "stop"})
            return 0
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "choice":
        msg = _choice_cmd(sys.argv[2:])
        if msg is None:
            print("usage: wispd choice [pick] [--prompt-id ID] "
                  "[--index N]", file=sys.stderr)
            return 2
        try:
            reply = ipc.send(msg)
            if isinstance(reply, dict) and reply.get("ok") is False:
                print(f"choice rejected: {reply.get('error')}",
                      file=sys.stderr)
                return 1
            return 0
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "label":
        # wispd label correct|incorrect [note] — soak intent-match;
        # bare `wispd label` prints the per-route report
        if len(sys.argv) < 3:
            from wisp import learn
            print(learn.soak_stats())
            return 0
        label = sys.argv[2]
        note = " ".join(sys.argv[3:])
        try:
            r = ipc.send({"cmd": "label", "label": label, "note": note})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError):
            from wisp import learn
            out = learn.label_last(label, note)
            print(out)
            return 0 if not out.startswith(("SKIP", "ERROR",
                                            "nothing")) else 1
    if cmd == "tasks":
        # wispd tasks — background agents: status + last log line
        from wisp import agents
        ts = agents.tasks()
        if not ts:
            print("no agents on record")
            return 0
        for name, t in sorted(ts.items(),
                              key=lambda kv: kv[1].get("ts", "")):
            tail = t.get("tail") or ""
            print(f"{t['status']:<10} {name:<24} {t.get('task','')[:50]}"
                  + (f"\n{'':<36}↳ {tail[:90]}" if tail else ""))
        return 0
    if cmd == "train":
        # wispd train stats|history|bank|replay — arena telemetry
        from wisp import train
        sub = sys.argv[2] if len(sys.argv) > 2 else "stats"
        if sub == "history":
            print(train.history_text())
        elif sub == "bank":
            print(train.bank_text())
        elif sub == "rebuild":
            bank = train.replay_all()
            print(f"rebuilt skill bank — {len(bank)} patterns")
        else:
            print(train.stats_text())
        return 0
    if cmd == "review":
        # wispd review [run [N]|approve N|reject N|list] — staged
        # reviewer proposals; approve is the only write path to the bank
        from wisp import review
        sub = sys.argv[2] if len(sys.argv) > 2 else "list"
        if sub == "run":
            n = int(sys.argv[3]) if len(sys.argv) > 3 else 10
            r = review.run(cfg, limit=n)
            print(f"reviewed {r['reviewed']} → {r['proposed']} proposals"
                  + (f", {r['skipped']} skipped" if r["skipped"] else ""))
            for note in r["notes"][:5]:
                print(f"  - {note}")
        elif sub == "approve":
            print(review.approve(int(sys.argv[3])
                                 if len(sys.argv) > 3 else 0))
        elif sub == "reject":
            print(review.reject(int(sys.argv[3])
                                if len(sys.argv) > 3 else 0))
        else:
            print(review.list_text())
        return 0
    if cmd == "learn":
        from wisp import learn
        out = learn.weekly()
        print(out if out else "no corrections this week — nothing to propose")
        return 0
    if cmd == "config":
        # wispd config                      -> print config
        # wispd config set section.key val  -> write + live reload via IPC
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub == "set" and len(sys.argv) > 4:
            k, v = sys.argv[3], sys.argv[4]
            section, _, key = k.rpartition(".")
            if not section or not key:
                print("usage: wispd config set section.key value",
                      file=sys.stderr)
                return 2
            try:
                resp = ipc.send({"cmd": "config", "set": {k: v}})
                if not resp.get("ok"):
                    print(f"error: {resp.get('error')}", file=sys.stderr)
                    return 1
            except (ConnectionError, OSError):
                try:
                    config.set_config(section, key, v)  # daemon down
                except ValueError as e:
                    print(f"error: {e}", file=sys.stderr)
                    return 1
            print(f"{k} = {v}")
            return 0
        import json
        try:
            print(json.dumps(ipc.send({"cmd": "config"})["config"],
                             indent=2))
        except (ConnectionError, OSError):
            print(json.dumps(config.load_config(), indent=2))
        return 0
    if cmd == "harness":
        return rebuild_harness()
    if cmd == "inventory":
        from wisp import inventory as _inv
        inv = _inv.scan(cfg)
        o = inv.get("omarchy", {})
        df = inv.get("dayflow", {})
        print(f"inventory.json — {inv.get('generated', '?')}")
        print(f"  apps:        {len(inv.get('apps', []))}")
        print(f"  cli_tools:   {len(inv.get('cli_tools', {}))}")
        print(f"  mcp servers: {len(inv.get('mcp', {}))} "
              f"({', '.join(list(inv.get('mcp', {}))[:8])}…)")
        print(f"  omarchy:     {len(o.get('plugins', []))} plugins, "
              f"{len(o.get('bindings', []))} bindings")
        print(f"  dayflow:     {len(df.get('top_apps', []))} top apps, "
              f"{len(df.get('project_terms', []))} project terms")
        print(f"  skills:      {len(inv.get('skills', []))}")
        print(f"  file: {_inv.FILE}")
        return 0
    if cmd == "connect":
        # wispd connect <service> — OAuth onboarding for the Strata
        # connector suite via the local browseros gateway. '--list'
        # dumps the connector catalog + status.
        from wisp import mcpauth
        name = sys.argv[2] if len(sys.argv) > 2 else ""
        if not name or name == "--list":
            if "--json" in sys.argv:
                import json as _j
                print(_j.dumps(mcpauth.list_connectors_json(cfg)))
                return 0
            print(mcpauth.list_connectors(cfg))
            return 0
        print(mcpauth.connect(name, cfg))
        return 0
    if cmd == "context":
        try:
            r = ipc.send({"cmd": "context"})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd in ("task_status", "task_cancel"):
        try:
            r = ipc.send({"cmd": cmd, "name": sys.argv[2]
                          if len(sys.argv) > 2 else ""})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "memory-write":
        # GUI editor path — `wispd memory-write <target> <base64>`
        # (argv can't carry raw newlines; body decodes server-side)
        import base64
        try:
            body = base64.b64decode(sys.argv[3]).decode()
            r = ipc.send({"cmd": "memory", "target": sys.argv[2],
                          "body": body})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (IndexError, ValueError) as e:
            print(f"usage: wispd memory-write memory|user <b64> ({e})",
                  file=sys.stderr)
            return 2
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd in ("agent", "memory"):
        # GUI hooks — `wispd agent <task>` spawns a background runtime
        # task, `wispd memory 'target|op|old|new'` edits MEMORY/USER.md
        field = "task" if cmd == "agent" else "arg"
        try:
            r = ipc.send({"cmd": cmd, field: " ".join(sys.argv[2:])})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "trace":
        from wisp import trace
        return trace.main(sys.argv[2:])
    if cmd == "doctor":
        return _doctor(cfg)
    if cmd == "models":
        return _models(cfg, sys.argv[2:])
    if cmd == "tui":
        from wisp import tui
        return tui.main()
    if cmd == "skills":
        from wisp import skills
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub == "import":
            preview = "--list" in sys.argv
            srcs = [a for a in sys.argv[3:] if not a.startswith("--")]
            if not srcs:
                print("usage: wispd skills import [--list] <dir>",
                      file=sys.stderr)
                return 2
            print(skills.import_dir(srcs[0], preview=preview))
            return 0
        for s in skills.index():
            print(f"{s['name']}: {s['description']}")
        return 0
    if cmd == "suggestions":
        try:
            r = ipc.send({"cmd": "suggestions"})
            for s in r.get("suggestions", []):
                print(f"[{s.get('status','?')}] {s.get('title','')} "
                      f"— {s.get('evidence','')}")
            return 0
        except (ConnectionError, OSError) as e:
            print(f"wispd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "theme":
        from wisp import theme
        name = sys.argv[2] if len(sys.argv) > 2 else ""
        if name in ("--check", "--css"):
            # wispd theme --check [THEME_DIR]      contrast audit, exit 1 on fail
            # wispd theme --css [THEME_DIR] [OUT]  theme.css (OUT '-' = stdout)
            rest = sys.argv[3:]
            res = theme.load(rest[0] if rest else None, cfg)
            if name == "--css":
                out = rest[1] if len(rest) > 1 else None
                if out == "-":
                    sys.stdout.write(theme.css(res))
                else:
                    print(theme.write_css(res, out))
                return 0
            rows = theme.check(res)
            print(f"source {res['source']}, mode {res['mode']}")
            for r in rows:
                mark = "ok  " if r["ok"] else "FAIL"
                print(f"{mark} {r['pair']:<18} {r['fg']} on {r['bg']}  "
                      f"{r['ratio']:>5.2f} (min {r['min']})")
            return 0 if all(r["ok"] for r in rows) else 1
        if name:
            if name not in theme.THEMES:
                print(f"unknown theme {name!r} — "
                      f"{', '.join(sorted(theme.THEMES))}",
                      file=sys.stderr)
                return 2
            config.set_config("ui", "theme", name)
            cfg = config.load_config()
            print(f"theme = {theme.emit(cfg)}")
        else:
            theme.emit(cfg)
            print(theme.current(cfg))
        return 0
    if cmd == "fails":
        from wisp import learn
        print(learn.fails())
        return 0
    if cmd == "tele":
        # wispd tele [hours] — local digest over decisions/trace
        from wisp import telemetry
        hours = int(sys.argv[2]) if len(sys.argv) > 2 else 24
        print(telemetry.text(hours))
        return 0
    if cmd == "eval":
        # wispd eval route [limit] — replay logged decisions through
        # candidate routers (eval spend: orchestral key per org rule)
        from wisp import evalroute
        if len(sys.argv) > 2 and sys.argv[2] != "route":
            print("usage: wispd eval route [limit]", file=sys.stderr)
            return 2
        limit = int(sys.argv[3]) if len(sys.argv) > 3 else 0
        print(evalroute.run(cfg, limit=limit))
        return 0
    if cmd == "sync":
        # refresh MEMORY.md constitution block + import luke-agents
        # _LUKE skills (snapshot, never symlink)
        from wisp import memory as _m, skills as _sk
        print(_m.sync_constitution(sys.argv[2] if len(sys.argv) > 2
                                   else None))
        print(_sk.import_dir(
            "~/Documents/github/personal/luke-agents/_LUKE"))
        _sk.write_index_json()
        return 0
    if cmd == "recipes":
        from wisp import trajectories
        from wisp import skills as _sk
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub == "approve":
            name = sys.argv[3] if len(sys.argv) > 3 else ""
            src = config.DATA_DIR / "proposals" / f"{name}.md"
            if not name.startswith("recipe-") or not src.exists():
                print("usage: wispd recipes approve <recipe-name>",
                      file=sys.stderr)
                return 2
            dest = _sk.SKILLS_DIR / name
            dest.mkdir(parents=True, exist_ok=True)
            from datetime import datetime, timezone
            body = src.read_text()
            body += ("\n<!-- approved by wispd recipes approve "
                     f"{datetime.now(timezone.utc).isoformat()} "
                     "— human-gated install -->\n")
            (dest / "SKILL.md").write_text(body)
            _sk.write_index_json()
            print(f"installed {name}")
            return 0
        for p in trajectories.propose_recipes():
            print(f"drafted {p}")
        return 0
    print("usage: wispd [daemon|install|trigger|status|stop|choice"
          "|agent|memory|task_status|task_cancel|learn|label|harness|trace"
          "|doctor|models [start [--run]]|tui|skills [import [--list] dir]|suggestions"
          "|recipes [approve name]|fails|theme [name|--check|--css]|sync [repo]"
          "|eval route [n]"
          "|config [set k v]]")
    return 2


