# Pinned cua-driver release. Upgrade is a one-line diff: bump CUA_VERSION and
# the per-arch URL + SHA256 (of the downloaded file, the driver binary).
# install.sh refuses any download whose sha256 differs. wisp/probes_cua.py
# reads CUA_VERSION and reports `version_mismatch` when the running driver
# differs.
CUA_VERSION=0.33.1
# aarch64 sha256 is the binary installed and verified on omarchy-max
# (cua-driver 0.33.1). URLs are the expected release asset paths: confirm
# against the real release before the first non-dry-run install.
CUA_URL_AARCH64=https://github.com/trycua/cua/releases/download/cua-driver-v0.33.1/cua-driver-linux-aarch64
CUA_SHA256_AARCH64=dc25e309ea306f7229726a7fc9873f8086accc16b11ca914c26fbb1c148284a8
# x86_64: no pin yet (fill both lines to enable; install.sh refuses without).
