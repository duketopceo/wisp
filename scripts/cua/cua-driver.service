[Unit]
Description=cua-driver computer-use daemon (Wayland backend)
After=graphical-session.target

[Service]
Environment=CUA_DRIVER_RS_ENABLE_WAYLAND=1
ExecStart=%h/.local/share/cua-driver/cua-driver serve
Restart=on-failure
RestartSec=5
# session.slice keeps systemd-oomd (app.slice) from picking the driver
Slice=session.slice
MemoryMax=512M

[Install]
WantedBy=default.target
