  "dom-hard": [
    ["click ALPHA and then click DELTA",
     "return s.counts['btn-alpha'] >= 1 && s.counts['btn-delta'] >= 1"],
    ["click the third checkbox",
     "return s.counts['chk-3'] >= 1"],
    ["select 'beta' in the dropdown",
     "return s.events.some(e => e.id==='sel' && e.value==='beta')"],
    ["type 'wisp' into the text field then click BRAVO",
     "return (s.typed['textin']||'').includes('wisp') && s.counts['btn-bravo'] >= 1"],
    ["scroll the list to the bottom then click ECHO",
