[Desktop Entry]
Type=Application
Version=1.5
Name=Wisp
GenericName=Voice Assistant
Comment=Wisp voice assistant: talk, stop, open settings
Exec=@WISPD@ settings
Icon=wisp
Terminal=false
Categories=Utility;Accessibility;
Keywords=voice;assistant;ai;wisp;
StartupNotify=false
Actions=Listen;Stop;Settings;

[Desktop Action Listen]
Name=Listen
Exec=@WISPD@ trigger
Icon=wisp

[Desktop Action Stop]
Name=Stop
Exec=@WISPD@ interrupt
Icon=wisp

[Desktop Action Settings]
Name=Settings
Exec=@WISPD@ settings
Icon=wisp
