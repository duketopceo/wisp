{
  "manifest_version": 3,
  "name": "Wisp browser lane",
  "description": "Lets Wisp work in a tab group beside yours, in plain sight, and stops the moment you press Stop. Off until you press Connect.",
  "version": "0.2.0",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Wisp browser lane"
  },
  "commands": {
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop Wisp in this browser"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
