#!/usr/bin/env python3
"""dimd — Dim: hotkey-triggered voice -> Jev -> Hyprland action.

Flow: Hyprland bind spawns `dimd trigger`. dimd shows the dim overlay
(breathing with mic amplitude), records Ns of mic audio via pw-record,
transcribes with whisper.cpp, asks Jev (OpenRouter decisions endpoint) for
app/action/risk, then:
  - confidence >= 0.95: execute immediately
  - 0.8 <= confidence < 0.95: execute + notify confidence
  - confidence < 0.8: show ambiguous choices as clickable overlay buttons
Every decision is appended to data/corrections.jsonl (self-improving lane).
Only risk <= threshold and action == launch is executed automatically.
"""
import json
import os
import pathlib
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

HOME = pathlib.Path.home()
CFG_DIR = HOME / ".config" / "dim-agent"
CFG_FILE = CFG_DIR / "config.toml"
ENV_FILE = CFG_DIR / ".env"
REPO_DIR = HOME / "GitHub" / "duketopceo" / "dim-agent"
CORRECTIONS = REPO_DIR / "data" / "corrections.jsonl"
RUN_DIR = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "dim-agent"
LEVEL_FILE = RUN_DIR / "level"
WHISPER_HOME = HOME / "src" / "whisper.cpp"
WHISPER_BIN = WHISPER_HOME / "build" / "bin" / "whisper-cli"
WHISPER_MODEL = WHISPER_HOME / "models" / "ggml-base.en.bin"
OVERLAY_BIN = HOME / ".local" / "opt" / "dim-agent" / "dim-overlay"

DEFAULT_CONFIG = """\
[hotkey]
# Right Alt + Space = push-to-talk (Super+Space is reserved for input-method
# switching). Hyprland modmask token + key, remappable here.
mod = "ALT_R"
key = "Space"

[audio]
seconds = 5

[agent]
model = "~typesafe/jev-latest"
# Auto-execute when risk <= threshold. Measured Jev scores: "open terminal"
# launch scores ~1.2 (navigational band), so 1.5 = launch/close allowed,
# mutating (>=2) always requires explicit confirmation.
risk_threshold = 1.5
confidence_instant = 0.95
confidence_ambiguous = 0.8

[apps]
browser = "chromium"
terminal = "ghostty"
files = "nautilus"
vscode = "code"
music = "spotify"
settings = "gnome-control-center"
browser_new_tab = "chromium"
"""

JEV_ENDPOINT = "https://openrouter.ai/api/alpha/decisions"

JEV_QUESTIONS = {
    "app": {
        "type": "choice",
        "instructions": "Which application is the user asking about?",
        "criteria": {
            "browser": "user wants a web browser or a website",
            "terminal": "user wants a terminal or shell",
            "files": "user wants a file manager",
            "vscode": "user wants the code editor",
            "music": "user wants a music player",
            "settings": "user wants system settings",
            "browser_new_tab": "user wants a new browser tab",
        },
    },
    "action": {
        "type": "choice",
        "instructions": "What should be done with it?",
        "criteria": {
            "launch": "open or start it",
            "close": "close or quit it",
            "type_text": "type some text",
            "run_shell": "run a shell command",
        },
    },
    "risk": {
        "type": "score",
        "instructions": "0 read-only launch, 2 mutating",
        "criteria": ["read-only", "navigational", "mutating"],
    },
}


# ---------------------------------------------------------------- config/env

def load_config() -> dict:
    """Parse a flat [section] key = "value" TOML subset without deps."""
    cfg = {}
    if CFG_FILE.exists():
        section = None
        for raw in CFG_FILE.read_text().splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("["):
                section = line.strip("[]")
                cfg[section] = {}
            elif "=" in line and section:
                k, v = (p.strip() for p in line.split("=", 1))
                cfg[section][k] = v.strip('"')
    else:
        CFG_DIR.mkdir(parents=True, exist_ok=True)
        CFG_FILE.write_text(DEFAULT_CONFIG)
        import tomllib  # noqa: F401  (config written; next run parses)
        cfg = _default_cfg_dict()
    return cfg


def _default_cfg_dict():
    return {
        "hotkey": {"mod": "ALT_R", "key": "Space"},
        "audio": {"seconds": "5"},
        "agent": {
            "model": "~typesafe/jev-latest", "risk_threshold": "1.5",
            "confidence_instant": "0.95", "confidence_ambiguous": "0.8",
        },
        "apps": {
            "browser": "chromium", "terminal": "kitty", "files": "nautilus",
            "vscode": "code", "music": "spotify",
            "settings": "gnome-control-center", "browser_new_tab": "chromium",
        },
    }


def load_api_key() -> str:
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line.startswith("OPENROUTER_API_KEY="):
                return line.split("=", 1)[1].strip()
    key = os.environ.get("OPENROUTER_API_KEY", "")
    if not key:
        raise RuntimeError(f"No OPENROUTER_API_KEY in {ENV_FILE} or environment")
    return key


def hypr_env() -> dict:
    """Hyprland tooling needs its instance signature when run from a daemon."""
    env = dict(os.environ)
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        rd = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        hypr = pathlib.Path(rd) / "hypr"
        if hypr.is_dir():
            env["HYPRLAND_INSTANCE_SIGNATURE"] = sorted(hypr.iterdir())[0].name
    return env


def notify(msg: str) -> None:
    subprocess.run(["notify-send", "Dim", msg], env=hypr_env())


# ------------------------------------------------------------------ pipeline

def record(seconds: int) -> pathlib.Path:
    out = CFG_DIR / "utterance.wav"
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    sampler = threading.Thread(target=_amplitude_sampler, args=(seconds,), daemon=True)
    sampler.start()
    rec = shutil.which("pw-record") or shutil.which("arecord")
    if rec is None:
        raise RuntimeError("no pw-record or arecord found")
    if rec.endswith("pw-record"):
        cmd = [rec, "--rate", "16000", "--channels", "1", "--format", "s16",
               "--sample-count", str(16000 * seconds), str(out)]
    else:
        cmd = [rec, "-D", "default", "-r", "16000", "-c", "1", "-f", "S16_LE",
               "-d", str(seconds), str(out)]
    subprocess.run(cmd, check=True, timeout=seconds + 10, env=hypr_env())
    time.sleep(0.3)
    LEVEL_FILE.write_text("0.0")  # silence restores full brightness
    return out


def _amplitude_sampler(seconds: int) -> None:
    """Breathing darkness: sample mic RMS, publish to level file for overlay.

    Silence -> 0.0 (overlay fully transparent, screen bright); loud -> 1.0
    (overlay dark). Uses arecord as a passive second reader on the default
    source; failure is non-fatal (overlay just stays static).
    """
    arec = shutil.which("arecord")
    if not arec:
        return
    try:
        proc = subprocess.Popen(
            [arec, "-D", "default", "-f", "U8", "-r", "200", "-c", "1", "-d", str(seconds)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=hypr_env())
        while True:
            chunk = proc.stdout.read(200)  # ~1s of U8@200Hz... read in sub-chunks
            if not chunk:
                break
            step = 20  # ~100ms windows
            for i in range(0, len(chunk) - step, step):
                w = chunk[i:i + step]
                rms = sum(abs(b - 128) for b in w) / (len(w) * 128)
                LEVEL_FILE.write_text(f"{min(1.0, rms * 6):.3f}")
        proc.wait(timeout=5)
    except Exception:
        try:
            LEVEL_FILE.write_text("0.0")
        except Exception:
            pass


def transcribe(wav: pathlib.Path) -> str:
    if not (WHISPER_BIN.exists() and WHISPER_MODEL.exists()):
        raise RuntimeError(f"whisper.cpp missing: {WHISPER_BIN} / {WHISPER_MODEL}")
    r = subprocess.run(
        [str(WHISPER_BIN), "-m", str(WHISPER_MODEL), "-nt", "-f", str(wav)],
        capture_output=True, text=True, timeout=120)
    return " ".join(r.stdout.split())


def ask_jev(transcript: str, model: str) -> dict:
    payload = {"model": model, "state": transcript, "questions": JEV_QUESTIONS}
    req = urllib.request.Request(
        JEV_ENDPOINT, data=json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {load_api_key()}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/duketopceo/dim-agent",
            "X-Title": "Dim",
        }, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Jev HTTP {e.code}: {e.read().decode()[:200]}") from None


def execute(answers: dict, cfg: dict) -> str:
    apps = cfg.get("apps", {})
    agent = cfg.get("agent", {})
    threshold = float(agent.get("risk_threshold", "1.5"))
    action = answers.get("action", {}).get("choice")
    app = answers.get("app", {}).get("choice")
    risk = float(answers.get("risk", {}).get("score", 2))

    if risk > threshold:
        return f"BLOCKED (risk={risk:.2f} > {threshold})"
    if action != "launch":
        return f"SKIP (action={action!r} not auto-executed in v0.1)"
    binname = apps.get(app)
    if not binname:
        return f"SKIP (unknown app {app!r})"
    # Hyprland 0.56: hyprctl dispatch exec <cmd> hits a Lua parse bug
    # (hyprwm/Hyprland#16224); the working path is the Lua dispatcher.
    r = subprocess.run(["hyprctl", "eval", f'hl.dsp.exec_cmd("{binname}")'],
                       capture_output=True, text=True, env=hypr_env())
    if r.returncode != 0 or "ok" not in r.stdout:
        subprocess.run(["hyprctl", "dispatch", "exec", binname],
                       capture_output=True, env=hypr_env())
    return f"LAUNCHED {app} -> {binname}"


def log_decision(record_dict: dict) -> None:
    try:
        CORRECTIONS.parent.mkdir(parents=True, exist_ok=True)
        with CORRECTIONS.open("a") as f:
            f.write(json.dumps(record_dict) + "\n")
    except Exception:
        pass


def ambiguous_choice(answers: dict, cfg: dict) -> dict | None:
    """Confidence gate: below threshold, offer the ambiguous choices as
    clickable overlay buttons; return the user-corrected answers or None."""
    app_a, act_a = answers.get("app", {}), answers.get("action", {})
    conf = min(app_a.get("confidence", 1), act_a.get("confidence", 1))
    thresh = float(cfg.get("agent", {}).get("confidence_ambiguous", "0.8"))
    if conf >= thresh:
        return None
    app_probs = sorted(app_a.get("probabilities", {}).items(), key=lambda kv: -kv[1])[:3]
    act_probs = sorted(act_a.get("probabilities", {}).items(), key=lambda kv: -kv[1])[:3]
    labels = [f"app:{k}" for k, _ in app_probs] + [f"action:{k}" for k, _ in act_probs]
    overlay_args = ["--buttons"] + labels
    r = subprocess.run([str(OVERLAY_BIN)] + overlay_args, capture_output=True,
                       text=True, timeout=60, env=hypr_env())
    picked = r.stdout.strip()
    if not picked:
        return None
    kind, _, value = picked.partition(":")
    corrected = json.loads(json.dumps(answers))
    if kind == "app":
        corrected["app"]["choice"] = value
    else:
        corrected["action"]["choice"] = value
    corrected["corrected_by_user"] = True
    return corrected


def run_once(cfg: dict) -> int:
    secs = int(cfg.get("audio", {}).get("seconds", "5"))
    model = cfg.get("agent", {}).get("model", "~typesafe/jev-latest")
    overlay = None
    try:
        if OVERLAY_BIN.exists():
            overlay = subprocess.Popen([str(OVERLAY_BIN)], env=hypr_env(),
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        wav = record(secs)
        text = transcribe(wav)
        print(f"transcript: {text!r}")
        if not text:
            notify("heard nothing")
            return 0
        resp = ask_jev(text, model)
        answers = resp.get("answers", {})
        print(f"jev: {json.dumps(answers)[:400]}")
        corrected = ambiguous_choice(answers, cfg)
        if corrected:
            answers = corrected
        result = execute(answers, cfg)
        print(f"result: {result}")
        notify(result)
        log_decision({
            "ts": datetime.now(timezone.utc).isoformat(),
            "transcript": text, "answers": answers, "result": result,
            "corrected": bool(answers.get("corrected_by_user")),
        })
        return 0
    except Exception as e:
        notify(f"error: {e}")
        print(f"error: {e}", file=sys.stderr)
        return 1
    finally:
        if overlay:
            overlay.terminate()


def install_bind(cfg: dict) -> None:
    """Idempotently add the push-to-talk bind to hyprland.conf."""
    conf = HOME / ".config" / "hypr" / "hyprland.conf"
    mod = cfg.get("hotkey", {}).get("mod", "ALT_R")
    key = cfg.get("hotkey", {}).get("key", "Space")
    bind = f"bind = {mod}, {key}, exec, {HOME}/.local/bin/dim-agent-trigger"
    text = conf.read_text() if conf.exists() else ""
    if "dim-agent-trigger" in text:
        print(f"bind already present: {bind}")
        return
    with conf.open("a") as f:
        f.write(f"\n# Dim push-to-talk\n{bind}\n")
    print(f"added bind: {bind}")
    subprocess.run(["hyprctl", "reload"], env=hypr_env(), capture_output=True)


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    cfg = load_config()
    if cmd == "install":
        install_bind(cfg)
        return 0
    if cmd == "trigger":
        return run_once(cfg)
    print("usage: dimd [install|trigger]")
    return 2


if __name__ == "__main__":
    sys.exit(main())
