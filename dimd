#!/usr/bin/env python3
"""dimd — Dim: resident voice assistant daemon for Omarchy.

`dimd daemon` runs the IPC server (systemd user service). `dimd trigger`
is the push-to-talk client the Hyprland bind executes — it sends `listen`
to the running daemon, or runs the pipeline inline when no daemon is up.
Other subcommands: status, stop, install, harness.
"""
import pathlib
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from dim import config, ipc, pipeline, speech, state as state_mod  # noqa: E402


def _handler(st: state_mod.State, cfg: dict, ctl: dict) -> callable:
    def handle(cmd: dict) -> dict:
        c = cmd.get("cmd")
        _t0 = __import__("time").monotonic()
        from dim import trace as _trace
        out = _dispatch(c, cmd)
        _trace.emit("sys", "ipc", "ipc",
                    {"cmd": c, "ok": out.get("ok")},
                    round((__import__("time").monotonic() - _t0) * 1000))
        return out

    def _dispatch(c: str, cmd: dict) -> dict:
        if c == "status":
            from dim import agents
            st.tasks = agents.tasks()
            st.transition(st.status)
            return {"ok": True, "state": st.snapshot()}
        if c == "listen":
            if ctl["busy"].is_set():
                return {"ok": False, "error": "busy"}
            speech.stop()
            ctl["busy"].set()
            threading.Thread(target=_run_listen, args=(st, cfg, ctl),
                             daemon=True).start()
            return {"ok": True}
        if c == "choice":
            ctl["choice_pick"] = cmd.get("pick", "")
            ctl["choice_event"].set()
            return {"ok": True}
        if c == "task_status":
            from dim import agents
            return {"ok": True, "result": agents.status(cmd.get("name", ""))}
        if c == "task_cancel":
            from dim import agents
            return {"ok": True, "result": agents.cancel(cmd.get("name", ""))}
        if c == "agent":
            from dim import agents
            return {"ok": True,
                    "result": agents.spawn(cmd.get("task", ""), cfg)}
        if c == "memory":
            from dim import memory
            if "body" in cmd:  # GUI whole-doc write — pipes/newlines safe
                return {"ok": True, "result": memory.edit(
                    cmd.get("target", "memory"), "write",
                    "", cmd.get("body", ""))}
            return {"ok": True,
                    "result": memory.run(cmd.get("arg", ""))}
        if c == "learn":
            from dim import learn
            p = learn.weekly(7)
            return {"ok": True,
                    "result": p if p else "nothing to propose"}
        if c == "harness":
            try:
                rc = rebuild_harness()
                return {"ok": rc == 0,
                        "result": "harness rebuilt" if rc == 0
                                  else f"builder exited {rc}"}
            except Exception as e:
                return {"ok": False, "error": str(e)}
        if c == "config":
            set_fields = cmd.get("set") or {}
            for k, v in set_fields.items():
                section, _, key = k.rpartition(".")
                if not section or not key:
                    return {"ok": False, "error": "config keys must be section.key"}
                try:
                    config.set_config(section, key, str(v))
                except ValueError as e:
                    return {"ok": False, "error": str(e)}
            if set_fields:  # live-reload
                cfg.clear()
                cfg.update(config.load_config())
            return {"ok": True, "config": cfg}
        if c == "stop":
            speech.stop()
            ctl["stop"].set()
            return {"ok": True}
        return {"ok": False, "error": f"unknown cmd {c!r}"}
    return handle


def _wait_for_choice(ctl: dict):
    def wait(timeout: float):
        ctl["choice_event"].clear()
        ctl["choice_pick"] = ""
        if ctl["choice_event"].wait(timeout):
            return ctl["choice_pick"] or None
        return None
    return wait


def _run_listen(st: state_mod.State, cfg: dict, ctl: dict) -> None:
    try:
        pipeline.run_listen(cfg, st, wait_for_choice=_wait_for_choice(ctl))
    finally:
        ctl["busy"].clear()


def run_daemon(cfg: dict) -> int:
    from dim import skills
    skills.register_tools()  # skill_<name> entries from skills/*/SKILL.md
    st = state_mod.State()
    ctl = {"stop": threading.Event(), "busy": threading.Event(),
           "choice_event": threading.Event(), "choice_pick": ""}
    server = ipc.Daemon(_handler(st, cfg, ctl))
    server.start()
    print(f"dimd listening on {config.SOCK_FILE}")
    try:
        ctl["stop"].wait()
    except KeyboardInterrupt:
        pass
    finally:
        server.stop()
        st.transition("idle")
    return 0


def cmd_trigger(cfg: dict) -> int:
    try:
        resp = ipc.send({"cmd": "listen"})
        if resp.get("ok"):
            return 0
        print(f"dimd: {resp.get('error')}", file=sys.stderr)
        return 1
    except (ConnectionError, OSError):
        # No daemon: run the pipeline inline so the bind still works
        # before the systemd unit is installed/enabled.
        st = state_mod.State()
        return pipeline.run_listen(cfg, st)


def install_files() -> None:
    """Copy runtime files to ~/.local/opt/dim-agent, write the trigger shim
    and the systemd user unit, and install the shell plugin directory."""
    src = pathlib.Path(__file__).resolve().parent
    opt = config.HOME / ".local" / "opt" / "dim-agent"
    opt.mkdir(parents=True, exist_ok=True)
    pkg = src / "dim"
    if pkg.is_dir():
        shutil.copytree(pkg, opt / "dim", dirs_exist_ok=True)
        print(f"installed {opt}/dim")
    for name in ("dimd",):
        target = opt / name
        shutil.copy2(src / name, target)
        target.chmod(0o755)
        print(f"installed {target}")
    for extra in ("scripts/build_harness.py",):
        f = src / extra
        if f.exists():
            shutil.copy2(f, opt / f.name)
            print(f"installed {opt}/{f.name}")
    plugin_src = src / "shell-plugin"
    plugin_dst = (config.HOME / ".config" / "omarchy" / "plugins"
                  / "io.github.duketopceo.dim")
    if plugin_src.is_dir():
        shutil.copytree(plugin_src, plugin_dst, dirs_exist_ok=True)
        print(f"installed {plugin_dst}")
    trigger = config.HOME / ".local" / "bin" / "dim-agent-trigger"
    trigger.parent.mkdir(parents=True, exist_ok=True)
    trigger.write_text(f"#!/bin/sh\nexec python3 {opt}/dimd trigger\n")
    trigger.chmod(0o755)
    print(f"installed {trigger}")
    from dim import platform as _plat
    if _plat.current() == "windows":
        # Task Scheduler: run dimd daemon at logon (U8)
        exe = opt / "dimd.exe"
        subprocess.run(
            ["schtasks", "/create", "/tn", "DimAgent", "/sc", "onlogon",
             "/tr", f'"{exe} daemon"', "/f"],
            capture_output=True)
        print("registered Task Scheduler task DimAgent (logon)")
        return
    if _plat.current() == "macos":
        # launchd agent plist (U7)
        plist_dir = config.HOME / "Library" / "LaunchAgents"
        plist_dir.mkdir(parents=True, exist_ok=True)
        plist = plist_dir / "ai.dim.dimd.plist"
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>Label</key><string>ai.dim.dimd</string>
<key>ProgramArguments</key><array>
<string>{sys.executable}</string>
<string>{opt}/dimd</string><string>daemon</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/></dict></plist>""")
        print(f"installed {plist} (launchctl load to activate)")
        return
    unit_dir = config.HOME / ".config" / "systemd" / "user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    unit = unit_dir / "dimd.service"
    unit.write_text(f"""\
[Unit]
Description=Dim voice assistant daemon
After=graphical-session.target

[Service]
ExecStart={sys.executable} {opt}/dimd daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
""")
    print(f"installed {unit}")
    subprocess.run(["systemctl", "--user", "daemon-reload"],
                   capture_output=True)


def install_bind(cfg: dict) -> None:
    """Idempotently add the push-to-talk bind to ~/.config/hypr/bindings.lua.

    Omarchy configures Hyprland in Lua; hyprland.conf is not sourced, so a
    `bind =` line there is dead. Legacy installs wrote one — strip it.
    """
    from dim import platform
    if not platform.supports_hotkey_install():
        print("hotkey install is Linux/Hyprland-only — on macOS bind "
              "push-to-talk via SKHD/Raycast/a shortcut app: "
              "`dimd listen` (see docs/MACOS.md)")
        return
    mod = cfg.get("hotkey", {}).get("mod", "SUPER")
    key = cfg.get("hotkey", {}).get("key", "D")
    trigger = f"{config.HOME}/.local/bin/dim-agent-trigger"
    bind = (f'o.bind("{mod} + {key.upper()}", "Dim push-to-talk", '
            f'{{ launch = "{trigger}" }})')

    conf = config.HOME / ".config" / "hypr" / "hyprland.conf"
    if conf.exists() and "dim-agent-trigger" in conf.read_text():
        lines = [l for l in conf.read_text().splitlines()
                 if "dim-agent-trigger" not in l
                 and l.strip() != "# Dim push-to-talk"]
        conf.write_text("\n".join(lines) + "\n")
        print("removed dead bind from hyprland.conf (not sourced under Lua)")

    bindings = config.HOME / ".config" / "hypr" / "bindings.lua"
    text = bindings.read_text() if bindings.exists() else ""
    if "dim-agent-trigger" in text:
        print(f"bind already present in {bindings}")
        return
    with bindings.open("a") as f:
        f.write(f"\n-- Dim push-to-talk\n{bind}\n")
    print(f"added bind to {bindings}: {bind}")
    subprocess.run(["hyprctl", "reload"], env=pipeline.hypr_env(),
                   capture_output=True)


def rebuild_harness() -> int:
    builder = config.HOME / ".local" / "opt" / "dim-agent" / "build_harness.py"
    if not builder.exists():
        builder = (pathlib.Path(__file__).resolve().parent
                   / "scripts" / "build_harness.py")
    return subprocess.run([sys.executable, str(builder)]).returncode


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    cfg = config.load_config()
    if cmd == "daemon":
        return run_daemon(cfg)
    if cmd == "install":
        install_files()
        install_bind(cfg)
        return 0
    if cmd == "trigger":
        return cmd_trigger(cfg)
    if cmd == "status":
        try:
            import json
            print(json.dumps(ipc.send({"cmd": "status"}), indent=2))
            return 0
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "stop":
        try:
            ipc.send({"cmd": "stop"})
            return 0
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "choice":
        try:
            ipc.send({"cmd": "choice", "pick": sys.argv[2] if len(sys.argv) > 2 else ""})
            return 0
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "learn":
        from dim import learn
        out = learn.weekly()
        print(out if out else "no corrections this week — nothing to propose")
        return 0
    if cmd == "config":
        # dimd config                      -> print config
        # dimd config set section.key val  -> write + live reload via IPC
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub == "set" and len(sys.argv) > 4:
            k, v = sys.argv[3], sys.argv[4]
            section, _, key = k.rpartition(".")
            if not section or not key:
                print("usage: dimd config set section.key value",
                      file=sys.stderr)
                return 2
            try:
                resp = ipc.send({"cmd": "config", "set": {k: v}})
                if not resp.get("ok"):
                    print(f"error: {resp.get('error')}", file=sys.stderr)
                    return 1
            except (ConnectionError, OSError):
                try:
                    config.set_config(section, key, v)  # daemon down
                except ValueError as e:
                    print(f"error: {e}", file=sys.stderr)
                    return 1
            print(f"{k} = {v}")
            return 0
        import json
        try:
            print(json.dumps(ipc.send({"cmd": "config"})["config"],
                             indent=2))
        except (ConnectionError, OSError):
            print(json.dumps(config.load_config(), indent=2))
        return 0
    if cmd == "harness":
        return rebuild_harness()
    if cmd in ("task_status", "task_cancel"):
        try:
            r = ipc.send({"cmd": cmd, "name": sys.argv[2]
                          if len(sys.argv) > 2 else ""})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "memory-write":
        # GUI editor path — `dimd memory-write <target> <base64>`
        # (argv can't carry raw newlines; body decodes server-side)
        import base64
        try:
            body = base64.b64decode(sys.argv[3]).decode()
            r = ipc.send({"cmd": "memory", "target": sys.argv[2],
                          "body": body})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (IndexError, ValueError) as e:
            print(f"usage: dimd memory-write memory|user <b64> ({e})",
                  file=sys.stderr)
            return 2
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd in ("agent", "memory"):
        # GUI hooks — `dimd agent <task>` spawns a background runtime
        # task, `dimd memory 'target|op|old|new'` edits MEMORY/USER.md
        field = "task" if cmd == "agent" else "arg"
        try:
            r = ipc.send({"cmd": cmd, field: " ".join(sys.argv[2:])})
            print(r.get("result") or r.get("error", "failed"))
            return 0 if r.get("ok") else 1
        except (ConnectionError, OSError) as e:
            print(f"dimd unreachable: {e}", file=sys.stderr)
            return 1
    if cmd == "trace":
        from dim import trace
        return trace.main(sys.argv[2:])
    print("usage: dimd [daemon|install|trigger|status|stop|choice"
          "|agent|memory|task_status|task_cancel|learn|harness|trace"
          "|config [set k v]]")
    return 2


if __name__ == "__main__":
    sys.exit(main())
